/* ===== 根容器 ===== */
.intro-guide-root {
  position: fixed;
  inset: 0;
  z-index: 300;
}

/* ===== 遮罩 & 挖洞 ===== */
.intro-mask {
  position: fixed;
  inset: 0;
  z-index: 301;
}

.mask-block {
  position: fixed;
  background: rgba(0, 0, 0, 0.6);
  z-index: 301;
}

.hole-border {
  position: fixed;
  z-index: 302;
  border: 3rpx solid;
  border-radius: 16rpx;
  animation: holePulse 2s ease-in-out infinite;
  pointer-events: none;
}

@keyframes holePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

/* ===== 气泡 ===== */
.intro-bubble {
  position: fixed;
  z-index: 310;
  width: 560rpx;
  max-width: calc(100vw - 40rpx);
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx 24rpx;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.18);
  opacity: 0;
  transform: translateY(12rpx);
  animation: bubbleIn 280ms ease-out forwards;
}

/* 暗色模式气泡 */
.intro-guide-root.dark-mode .intro-bubble {
  background: #1e1e2e;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.4);
}

@keyframes bubbleIn {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 气泡箭头 */
.bubble-arrow {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
}

.bubble-arrow.arrow-down {
  bottom: -16rpx;
  border-top: 16rpx solid #ffffff;
}

.bubble-arrow.arrow-up {
  top: -16rpx;
  border-bottom: 16rpx solid #ffffff;
}

.intro-guide-root.dark-mode .bubble-arrow.arrow-down {
  border-top-color: #1e1e2e;
}

.intro-guide-root.dark-mode .bubble-arrow.arrow-up {
  border-bottom-color: #1e1e2e;
}

/* 气泡文案 */
.bubble-text {
  display: block;
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 700;
  line-height: 1.55;
}

.intro-guide-root.dark-mode .bubble-text {
  color: #e2e8f0;
}

/* 步骤指示圆点 */
.bubble-dots {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
}

.bubble-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  transition: all 250ms ease;
}

.bubble-dot.active {
  transform: scale(1.5);
}

.bubble-dot.done {
  background: #94a3b8;
}

/* 底部操作栏 */
.bubble-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
}

.bubble-step-hint {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 600;
}

.intro-guide-root.dark-mode .bubble-step-hint {
  color: #64748b;
}

.bubble-btn {
  padding: 14rpx 36rpx;
  border-radius: 20rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  border: none;
  line-height: 1.3;
}

/* ===== 收尾弹窗 ===== */
.completion-root {
  position: fixed;
  inset: 0;
  z-index: 320;
  display: flex;
  align-items: center;
  justify-content: center;
}

.completion-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.62);
  z-index: 320;
}

.completion-dialog {
  position: relative;
  z-index: 321;
  width: 560rpx;
  max-width: calc(100vw - 48rpx);
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 32rpx 32rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.25);
  animation: dialogIn 300ms ease-out;
}

.intro-guide-root.dark-mode .completion-dialog {
  background: #1e1e2e;
}

@keyframes dialogIn {
  from {
    opacity: 0;
    transform: scale(0.92) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.completion-title {
  display: block;
  font-size: 34rpx;
  color: #0f172a;
  font-weight: 800;
  text-align: center;
  margin-bottom: 16rpx;
}

.intro-guide-root.dark-mode .completion-title {
  color: #f1f5f9;
}

.completion-body {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.intro-guide-root.dark-mode .completion-body {
  color: #94a3b8;
}

.completion-buttons {
  display: flex;
  gap: 20rpx;
}

.completion-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  line-height: 80rpx;
  padding: 0;
  text-align: center;
}

.completion-btn.primary {
  color: #ffffff;
}

.completion-btn.secondary {
  color: #64748b;
  background: #f1f5f9;
  border: 2rpx solid #e2e8f0;
}

.intro-guide-root.dark-mode .completion-btn.secondary {
  color: #94a3b8;
  background: #2a2a3a;
  border-color: #3a3a4a;
}