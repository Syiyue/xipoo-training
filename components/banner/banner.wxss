.banner-root {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  transform: translateY(-200rpx);
}

.banner-inner {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 12rpx 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(30, 30, 45, 0.94);
  box-shadow: 0 10rpx 36rpx rgba(0, 0, 0, 0.24);
  backdrop-filter: blur(18rpx);
}

.banner-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  color: var(--brand-ink);
  background: linear-gradient(135deg, var(--brand-bright), var(--brand-soft));
  font-size: 28rpx;
  font-weight: 900;
}

.banner-text {
  min-width: 0;
  flex: 1;
}

.banner-name {
  display: block;
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
}

.banner-desc {
  display: block;
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 20rpx;
}

.banner-arrow {
  color: rgba(255, 255, 255, 0.44);
  font-size: 36rpx;
  font-weight: 200;
}