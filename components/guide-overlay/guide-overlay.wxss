.guide-root {
  position: fixed;
  inset: 0;
  z-index: 200;
}

.guide-mask {
  position: fixed;
  inset: 0;
  z-index: 201;
}

.mask-block {
  position: fixed;
  background: rgba(0, 0, 0, 0.6);
  z-index: 201;
}

.hole-border {
  position: fixed;
  z-index: 202;
  border: 2px solid #007AFF;
  border-radius: 12rpx;
  box-shadow: 0 0 24rpx rgba(0, 122, 255, 0.25);
  animation: holePulse 2s ease-in-out infinite;
  pointer-events: none;
}

@keyframes holePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.02); }
}

/* 底部浮窗 */
.guide-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 210;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.12);
  transform: translateY(100%);
  transition: transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.guide-sheet.sheet-enter {
  transform: translateY(0);
}

.sheet-step {
  font-size: 22rpx;
  color: #94a3b8;
  font-weight: 700;
  margin-bottom: 14rpx;
}

.sheet-text {
  display: block;
  font-size: 30rpx;
  color: #0f172a;
  font-weight: 800;
  line-height: 1.5;
  margin-bottom: 22rpx;
}

.sheet-dots {
  display: flex;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  transition: all 250ms ease;
}

.dot.active {
  background: #007AFF;
  transform: scale(1.4);
}

.dot.done {
  background: #94a3b8;
}

.sheet-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 20rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  background: #007AFF;
  border: none;
}
