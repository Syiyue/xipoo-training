/* 头像选择弹窗组件 - 薄荷绿+暖黄品牌配色 */
.avatar-picker-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 250ms ease;
}
.avatar-picker-overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.avatar-picker-modal {
  width: 100%;
  max-width: 700rpx;
  background: #ffffff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 36rpx 36rpx 60rpx;
  box-shadow: 0 -12rpx 48rpx rgba(0, 0, 0, 0.15);
  transform: translateY(100%);
  transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
}
.avatar-picker-modal.show {
  transform: translateY(0);
}

.picker-header {
  text-align: center;
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid #F0F0F0;
}
.picker-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E1E1E;
}

/* 预制头像网格 - 2行3列 */
.preset-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28rpx;
  margin-bottom: 48rpx;
  padding: 0 12rpx;
}
.preset-item {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid transparent;
  transition: border-color 200ms, box-shadow 200ms;
}
.preset-item.active {
  border-color: #FFD03C;
  box-shadow: 0 0 0 8rpx rgba(255, 208, 60, 0.3);
}
.preset-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 操作按钮区 */
.picker-actions {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.action-btn {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 16rpx;
  border-radius: 16rpx;
  background: transparent;
  border: none;
  outline: none;
  margin: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1E1E1E;
  text-align: left;
}
.action-btn::after {
  border: none;
}
.action-btn:active {
  background: var(--brand-tint-2);
}
.action-icon {
  font-size: 28rpx;
  font-weight: 700;
  width: 40rpx;
  text-align: center;
  flex-shrink: 0;
  color: var(--brand-primary);
}
.action-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E1E1E;
}
.cancel-action .action-text {
  color: #999999;
}
.action-divider {
  height: 1rpx;
  background: #EEEEEE;
  margin: 0 16rpx;
}