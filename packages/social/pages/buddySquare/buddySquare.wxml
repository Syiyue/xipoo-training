<view style="{{themeVars}}" class="container {{darkMode ? 'dark-mode' : ''}}">
  <view class="page-head">
    <view>
      <text class="page-title">{{lang === 'en' ? 'Team Square' : '组队广场'}}</text>
    </view>
    <button class="primary-btn" bindtap="openSettings">{{lang === 'en' ? 'Settings' : '设置'}}</button>
  </view>

  <!-- 模式切换 -->
  <view class="mode-bar">
    <view class="mode-tab {{mode === 'course' ? 'active' : ''}}" data-mode="course" bindtap="switchMode">{{lang === 'en' ? 'Course Team' : '课程组队'}}</view>
    <view class="mode-tab {{mode === 'general' ? 'active' : ''}}" data-mode="general" bindtap="switchMode">{{lang === 'en' ? 'Other Team' : '其他组队'}}</view>
  </view>

  <!-- 状态Tab -->
  <view class="tab-bar">
    <view class="tab-item {{tab === 'square' ? 'active' : ''}}" data-tab="square" bindtap="switchTab">{{lang === 'en' ? 'Square' : '广场'}}</view>
    <view class="tab-item {{tab === 'messages' ? 'active' : ''}}" data-tab="messages" bindtap="switchTab">
      {{lang === 'en' ? 'Messages' : '消息'}}
      <text wx:if="{{newMsgCount > 0}}" class="badge">{{newMsgCount}}</text>
    </view>
    <view class="tab-item {{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab">{{lang === 'en' ? 'Mine' : '我的'}}</view>
  </view>

  <!-- ========== 广场 Tab ========== -->
  <view wx:if="{{tab === 'square'}}" class="tab-content">
    <!-- 课程组队：选择课程 -->
    <view wx:if="{{mode === 'course'}}" class="course-pick">
      <view wx:if="{{!selectedCourse}}" class="course-list">
        <text class="pick-hint">{{lang === 'en' ? 'Select a course:' : '选择课程：'}}</text>
        <view wx:for="{{courses}}" wx:key="id" class="course-item" data-id="{{item.id}}" bindtap="selectCourse">
          <text class="course-code">{{item.courseCode || item.title}}</text>
          <text class="course-meta">{{item.section || ''}} · {{lang === 'en' ? 'W' : '周'}}{{item.weekday}} {{item.start}}-{{item.end}}</text>
        </view>
        <view wx:if="{{courses.length === 0}}" class="empty-sm">{{lang === 'en' ? 'No courses' : '暂无课程'}}</view>
      </view>
      <view wx:else class="selected-course">
        <text class="selected-label">{{selectedCourse.courseCode || selectedCourse.title}}</text>
        <text class="clear-link" bindtap="clearCourse">{{lang === 'en' ? 'Change' : '更换'}}</text>
      </view>
    </view>

    <!-- 我的招募（置顶） -->
    <view wx:if="{{myPosts.length > 0}}" class="my-section">
      <text class="sec-title">{{lang === 'en' ? 'My Recruitment' : '我的招募'}}</text>
      <view wx:for="{{myPosts}}" wx:key="id" class="post-card" data-postid="{{item.id}}" catchtap="openPostById" hover-class="post-hover">
        <view class="post-head"><text class="post-title">{{item.title}}</text><text class="post-count">{{item.memberCount || 0}}/{{item.maxMembers}}</text></view>
        <text class="post-desc">{{item.description || ''}}</text>
      </view>
    </view>

    <!-- 发布按钮（课程模式需先选课） -->
    <button wx:if="{{!showForm && (mode === 'general' || selectedCourse)}}" class="publish-toggle action-btn" bindtap="openForm">{{lang === 'en' ? '+ New Recruitment' : '+ 发布招募'}}</button>

    <!-- 发布表单 -->
    <view wx:if="{{showForm}}" class="publish-card">
      <view class="form-head">
        <text>{{lang === 'en' ? 'New Recruitment' : '发布招募'}}</text>
        <text class="form-close" bindtap="closeForm">×</text>
      </view>
      <input class="title-input" placeholder="{{lang === 'en' ? 'Title' : '招募标题'}}" value="{{formTitle}}" bindinput="onTitleInput" maxlength="50" />
      <textarea class="info-input" placeholder="{{lang === 'en' ? 'Details...' : '招募信息...'}}" value="{{formInfo}}" bindinput="onInfoInput" maxlength="500" />

      <view class="form-row">
        <text>{{lang === 'en' ? 'Members' : '目标人数'}}</text>
        <picker range="{{memberOptions}}" value="{{memberIdx}}" bindchange="onMemberPick">
          <view class="form-pick">{{memberOptions[memberIdx]}}{{lang === 'en' ? ' people' : '人'}}</view>
        </picker>
      </view>

      <view class="form-row">
        <text>{{lang === 'en' ? 'Gender' : '性别偏好'}}</text>
        <view class="gender-row-sm">
          <view class="g-opt {{formGender === 'any' ? 'active' : ''}}" data-g="any" bindtap="setFormGender">{{lang === 'en' ? 'Any' : '不限'}}</view>
          <view class="g-opt {{formGender === 'male' ? 'active' : ''}}" data-g="male" bindtap="setFormGender">{{lang === 'en' ? 'Male' : '男'}}</view>
          <view class="g-opt {{formGender === 'female' ? 'active' : ''}}" data-g="female" bindtap="setFormGender">{{lang === 'en' ? 'Female' : '女'}}</view>
        </view>
      </view>

      <view class="form-row">
        <text>{{lang === 'en' ? 'Location' : '地点'}}</text>
        <input class="form-input-inline" placeholder="{{lang === 'en' ? 'e.g. Library, Gym...' : '如：图书馆、体育馆...'}}" value="{{formLocation}}" bindinput="onFormLoc" maxlength="50" />
      </view>

      <view class="form-row">
        <text>{{lang === 'en' ? 'Deadline' : '截止时间'}}</text>
        <view class="form-inline">
          <picker mode="date" value="{{formDeadline}}" bindchange="onDeadlinePick">
            <view class="form-pick">{{formDeadline}}</view>
          </picker>
          <picker mode="time" value="{{formDeadlineTime}}" bindchange="onDeadlineTimePick">
            <view class="form-pick">{{formDeadlineTime}}</view>
          </picker>
        </view>
      </view>

      <button class="publish-btn action-btn" bindtap="publish">{{lang === 'en' ? 'Publish' : '发布'}}</button>
    </view>

    <!-- 招募广场 -->
    <text wx:if="{{posts.length > 0}}" class="sec-title sec-square">{{lang === 'en' ? 'Recruitment Square' : '招募广场'}}</text>
    <view wx:if="{{loading}}" class="loading">{{lang === 'en' ? 'Loading...' : '加载中...'}}</view>
    <view wx:else class="post-list">
      <view wx:for="{{posts}}" wx:key="id" class="post-card" data-id="{{item.id}}" bindtap="openPost" hover-class="post-hover">
        <view class="post-head"><text class="post-title">{{item.title}}</text><text class="post-count">{{item.memberCount || 0}}/{{item.maxMembers}}</text></view>
        <text class="post-desc">{{item.description || ''}}</text>
        <view class="post-foot">
          <text class="post-creator">{{item.creator ? item.creator.name : ''}}</text>
          <button wx:if="{{!item.isCreator && !item.isMember && !item.myApplicationStatus}}" class="apply-btn action-btn" data-id="{{item.id}}" data-title="{{item.title}}" catchtap="openApply">{{lang === 'en' ? 'Apply' : '申请加入'}}</button>
          <text wx:elif="{{item.myApplicationStatus === 'pending'}}" class="pending">{{lang === 'en' ? 'Pending' : '审核中'}}</text>
          <text wx:elif="{{item.isMember}}" class="joined">{{lang === 'en' ? 'Joined' : '已加入'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 消息 Tab ========== -->
  <view wx:if="{{tab === 'messages'}}" class="tab-content">
    <!-- 收到的申请 -->
    <text wx:if="{{receivedApps.length > 0}}" class="sec-title">{{lang === 'en' ? 'Received Applications' : '收到的申请'}}</text>
    <view wx:for="{{receivedApps}}" wx:key="id" class="msg-card" data-postid="{{item.postId}}" catchtap="openPostById">
      <text class="msg-title">{{item.postTitle || ''}}</text>
      <view class="applicant-info" wx:if="{{item.applicant}}" data-userid="{{item.applicant.id}}" catchtap="viewProfile">
        <text class="appl-name">{{item.applicant.name || ''}}</text>
        <text wx:if="{{item.applicant.grade}}" class="appl-meta">{{item.applicant.grade}} · {{item.applicant.major || ''}}</text>
      </view>
      <text wx:if="{{item.message}}" class="appl-msg">"{{item.message}}"</text>
      <view class="msg-actions" catchtap="noop">
        <button class="btn-accept-sm action-btn" data-id="{{item.id}}" catchtap="acceptApplication">{{lang === 'en' ? 'Accept' : '接受'}}</button>
        <button class="btn-reject-sm action-btn" data-id="{{item.id}}" catchtap="rejectApplication">{{lang === 'en' ? 'Reject' : '拒绝'}}</button>
      </view>
    </view>

    <!-- 我的申请 -->
    <text wx:if="{{myApps.length > 0}}" class="sec-title">{{lang === 'en' ? 'My Applications' : '我的申请'}}</text>
    <view wx:for="{{myApps}}" wx:key="id" class="msg-card" data-postid="{{item.postId || item.id}}" catchtap="openPostById">
      <text class="msg-title">{{item.postTitle || ''}}</text>
      <text class="msg-status {{item.status}}">{{item.status === 'pending' ? (lang === 'en' ? 'Pending' : '审核中') : (item.status === 'accepted' ? (lang === 'en' ? 'Accepted' : '已通过') : (lang === 'en' ? 'Rejected' : '已拒绝'))}}</text>
      <view wx:if="{{item.status === 'pending'}}" class="msg-actions" catchtap="noop">
        <button class="btn-reject-sm action-btn" data-id="{{item.id}}" catchtap="cancelMyApplication">{{lang === 'en' ? 'Cancel' : '撤回'}}</button>
      </view>
      <view wx:if="{{item.status === 'rejected'}}" class="msg-actions" catchtap="noop">
        <button class="btn-reject-sm action-btn" data-id="{{item.id}}" catchtap="deleteMyApplication">{{lang === 'en' ? 'Delete' : '删除'}}</button>
      </view>
    </view>

    <view wx:if="{{receivedApps.length === 0 && myApps.length === 0}}" class="empty">{{lang === 'en' ? 'No messages' : '暂无消息'}}</view>
  </view>

  <!-- ========== 我的 Tab ========== -->
  <view wx:if="{{tab === 'mine'}}" class="tab-content">
    <!-- 我的招募 -->
    <text wx:if="{{myPosts.length > 0}}" class="sec-title">{{lang === 'en' ? 'My Posts' : '我的招募'}}</text>
    <view wx:for="{{myPosts}}" wx:key="id" class="msg-card" data-postid="{{item.id}}" catchtap="openPostById">
      <text class="msg-title">{{item.title}}</text>
      <text class="msg-meta">{{item.memberCount || 0}}/{{item.maxMembers}} · {{item.status === 'expired' ? (lang === 'en' ? 'Ended' : '已截止') : item.status}}</text>
      <view class="msg-actions" catchtap="noop" wx:if="{{item.status === 'open'}}">
        <button class="btn-reject-sm action-btn" data-id="{{item.id}}" catchtap="cancelPost">{{lang === 'en' ? 'Cancel' : '取消招募'}}</button>
      </view>
    </view>

    <!-- 已配对 -->
    <text wx:if="{{myPairs.length > 0}}" class="sec-title">{{lang === 'en' ? 'Joined Teams' : '已加入的组队'}}</text>
    <view wx:for="{{myPairs}}" wx:key="id" class="msg-card" data-postid="{{item.id}}" catchtap="openPostById">
      <text class="msg-title">{{item.title}}</text>
      <text class="msg-meta">{{item.memberCount || 0}}/{{item.maxMembers}}</text>
    </view>

    <view wx:if="{{myPosts.length === 0 && myPairs.length === 0}}" class="empty">{{lang === 'en' ? 'Nothing yet' : '暂无内容'}}</view>
  </view>

  <!-- 申请弹窗 -->
  <view wx:if="{{applyOpen}}" class="modal-mask" catchtap="closeApply">
    <view class="editor" catchtap="noop">
      <view class="editor-head">
        <text>{{lang === 'en' ? 'Apply to Join' : '申请加入'}}</text>
        <button catchtap="closeApply">{{lang === 'en' ? 'Close' : '关闭'}}</button>
      </view>
      <text class="apply-post-title">{{applyPostTitle}}</text>
      <text class="sec-title">{{lang === 'en' ? 'Introduce Yourself' : '介绍自己'}}</text>
      <textarea class="apply-msg-input" placeholder="{{lang === 'en' ? 'Tell them why you want to join...' : '介绍一下自己，为什么想加入...'}}" value="{{applyMsg}}" bindinput="onApplyMsg" maxlength="300" />
      <button class="save-btn action-btn" bindtap="submitApply">{{lang === 'en' ? 'Submit Application' : '提交申请'}}</button>
    </view>
  </view>

  <!-- 设置弹窗 -->
  <view wx:if="{{settingsOpen}}" class="modal-mask" catchtap="closeSettings">
    <view class="editor" catchtap="noop">
      <view class="editor-head"><text>{{lang === 'en' ? 'Settings' : '设置'}}</text><button catchtap="closeSettings">{{lang === 'en' ? 'Close' : '关闭'}}</button></view>
      <text class="sec-title">{{lang === 'en' ? 'Select Tags' : '选择标签'}} ({{settingsSelectedTags.length}}/10)</text>
      <view wx:for="{{settingsTagGroups}}" wx:key="category" class="tag-group">
        <text class="tag-cat">{{item.label}}</text>
        <view class="tag-grid">
          <view wx:for="{{item.tags}}" wx:key="id" data-tagid="{{item.id}}" catchtap="toggleSettingsTag" class="tag-item {{item.selected ? 'active' : ''}}">{{lang === 'en' ? item.en : item.zh}}</view>
        </view>
      </view>
      <text class="sec-title">{{lang === 'en' ? 'Gender Filter' : '性别筛选'}}</text>
      <view class="gender-row">
        <view class="gender-opt {{settingsGender === 'any' ? 'active' : ''}}" data-g="any" bindtap="onSettingsGender">{{lang === 'en' ? 'Any' : '不限'}}</view>
        <view class="gender-opt {{settingsGender === 'male' ? 'active' : ''}}" data-g="male" bindtap="onSettingsGender">{{lang === 'en' ? 'Male only' : '仅限男'}}</view>
        <view class="gender-opt {{settingsGender === 'female' ? 'active' : ''}}" data-g="female" bindtap="onSettingsGender">{{lang === 'en' ? 'Female only' : '仅限女'}}</view>
      </view>
      <button class="save-btn action-btn" bindtap="saveSettings">{{lang === 'en' ? 'Save' : '保存'}}</button>
    </view>
  </view>
</view>
