/* π空间主理人页（模块 4）：状态标签复用统一样式 */
@import '../../../../styles/activity-card.wxss';

.paispace-page {
  min-height: 100vh;
  padding: 32rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* 顶部品牌区 */
.ps-brand {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #8b5cf6 0%, #6d5bd0 55%, #4f46b8 100%);
  box-shadow: 0 12rpx 32rpx rgba(109, 91, 208, 0.32);
  margin-bottom: 28rpx;
}
.ps-brand-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  background: #ffffff;
  flex-shrink: 0;
}
.ps-brand-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.ps-brand-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}
.ps-brand-intro {
  font-size: 22rpx;
  line-height: 32rpx;
  color: rgba(255, 255, 255, 0.88);
}

.ps-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #242a62;
}
.ps-stat {
  position: relative;
  min-width: 0;
  height: 116rpx;
  padding: 18rpx 8rpx;
  border-radius: 0;
  background: transparent;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
}
.ps-stat::after { border: 0; }
.ps-stat + .ps-stat { border-left: 1rpx solid rgba(255,255,255,.18); }
.ps-stat:active { background: rgba(255,255,255,.09); }
.ps-stat-num { font-size: 34rpx; font-weight: 800; }
.ps-stat-label { margin-top: 8rpx; font-size: 21rpx; color: rgba(255,255,255,.78); white-space: nowrap; }

.ps-manager-section { margin-bottom: 24rpx; }
.ps-section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx; font-size: 28rpx; font-weight: 700; color: var(--brand-ink, #242a62); }
.ps-section-head text:last-child { font-size: 22rpx; color: #79857e; }
.ps-manager-list { display: flex; flex-direction: column; gap: 14rpx; }
.ps-manager-card {
  width: 100%;
  min-width: 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #ffffff;
  display: grid;
  grid-template-columns: 84rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  text-align: left;
  line-height: 1.3;
  box-shadow: 0 6rpx 20rpx rgba(36,42,98,.07);
}
.ps-manager-card::after { border: 0; }
.ps-manager-avatar { width: 84rpx; height: 84rpx; border-radius: 50%; background: var(--brand-tint, #e8e9f7); }
.ps-manager-fallback { display: flex; align-items: center; justify-content: center; color: var(--brand-primary, #7c83c7); font-size: 30rpx; font-weight: 800; }
.ps-manager-copy { min-width: 0; display: flex; flex-direction: column; gap: 5rpx; }
.ps-manager-name { font-size: 27rpx; font-weight: 700; color: #242a62; }
.ps-manager-bio { font-size: 21rpx; color: #79857e; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ps-manager-tags { display: flex; gap: 8rpx; overflow: hidden; }
.ps-manager-tags text { flex-shrink: 0; padding: 3rpx 10rpx; border-radius: 6rpx; background: var(--brand-tint, #e8e9f7); color: var(--brand-primary, #7c83c7); font-size: 18rpx; }
.ps-manager-count { font-size: 20rpx; color: var(--brand-primary, #7c83c7); white-space: nowrap; }
.ps-manager-empty { padding: 42rpx 20rpx; border-radius: 20rpx; background: #ffffff; text-align: center; color: #999999; font-size: 24rpx; }

/* 分类标签栏 */
.ps-cat-bar {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.ps-cat-chip {
  display: inline-flex;
  align-items: center;
  height: 60rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 2rpx solid var(--brand-border, #d5d7eb);
  color: var(--brand-ink, #242a62);
  font-size: 24rpx;
  font-weight: 600;
}
.ps-cat-chip.active {
  background: var(--brand-primary, #7c83c7);
  border-color: var(--brand-primary, #7c83c7);
  color: #ffffff;
}

/* 瀑布流卡片 */
.ps-waterfall {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}
.ps-column {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.ps-card {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(36, 42, 98, 0.08);
}
.ps-card-img {
  width: 100%;
  height: 260rpx;
  display: block;
}
.ps-card-body {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.ps-card-title {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
  color: #2d3748;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ps-card-meta {
  font-size: 20rpx;
  line-height: 28rpx;
  color: #79857e;
}
.ps-card-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.ps-card-cat {
  height: 36rpx;
  line-height: 36rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: var(--brand-tint, #e8e9f7);
  color: var(--brand-primary, #7c83c7);
  font-size: 20rpx;
  font-weight: 600;
}
.ps-card-host {
  font-size: 20rpx;
  color: #999999;
}

.ps-empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #999999;
}
