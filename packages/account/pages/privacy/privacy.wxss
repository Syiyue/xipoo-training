.page {
  padding: 24rpx;
  min-height: 100vh;
  background: #f5f7f6;
}

.card {
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.06);
  overflow: hidden;
}

.privacy-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid var(--brand-border);
}

.privacy-item:last-child {
  border-bottom: none;
}

.privacy-label {
  color: var(--brand-ink);
  font-size: 26rpx;
  font-weight: 800;
}