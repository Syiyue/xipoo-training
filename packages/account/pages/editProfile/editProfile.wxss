.edit-profile-page { animation: pageFadeIn 300ms ease; }
.form-card { margin-top: 18rpx; padding: 28rpx; }
.avatar-section { display: flex; flex-direction: column; align-items: center; padding-bottom: 24rpx; border-bottom: 1rpx solid #eef2f7; }
.avatar-circle { width: 120rpx; height: 120rpx; border-radius: 999rpx; overflow: hidden; background: #e2e8f0; display: flex; align-items: center; justify-content: center; position: relative; }
.avatar-circle .avatar-img { width: 100%; height: 100%; }
.avatar-circle .avatar-text { color: #94a3b8; font-size: 44rpx; font-weight: 900; }
.form-row { margin-top: 22rpx; }
.form-label { display: block; margin-bottom: 8rpx; color: #64748b; font-size: 22rpx; font-weight: 800; }
.form-input { height: 72rpx; padding: 0 20rpx; border-radius: 18rpx; color: #0f172a; font-size: 24rpx; background: var(--brand-tint-2); display: flex; align-items: center; }
.school-select {
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #0f172a;
  font-size: 24rpx;
  background: var(--brand-tint-2);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.school-value { flex: 1; }
.school-value.placeholder { color: #94a3b8; }
.school-arrow { color: #94a3b8; font-size: 28rpx; }
.save-btn { margin-top: 32rpx; }
.hidden-canvas { position: absolute; top: -9999rpx; left: -9999rpx; }

.preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 200ms ease;
}

.preview-content {
  width: 600rpx;
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  animation: slideUp 300ms ease;
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #0f172a;
}

.preview-close {
  font-size: 40rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.preview-image-wrapper {
  padding: 40rpx;
  background: #f8fafc;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 400rpx;
}

.preview-image {
  max-width: 100%;
  max-height: 500rpx;
  border-radius: 16rpx;
}

.preview-actions {
  display: flex;
  gap: 24rpx;
  padding: 32rpx;
}

.preview-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-btn.cancel {
  background: #f1f5f9;
  color: #64748b;
}

.preview-btn.confirm {
  background: var(--brand-primary);
  color: #fff;
}

.upload-progress-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.progress-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.progress-icon {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.progress-ring {
  width: 100%;
  height: 100%;
}

.progress-bg {
  fill: none;
}

.progress-circle {
  fill: none;
  transition: stroke-dashoffset 0.3s ease;
}

.progress-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 32rpx;
  font-weight: 900;
  color: #fff;
}

.progress-message {
  font-size: 28rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.6);
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1002;
  animation: fadeIn 200ms ease;
}

.picker-content {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  animation: slideUp 300ms ease;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.picker-cancel {
  font-size: 28rpx;
  color: #64748b;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #0f172a;
}

.picker-confirm {
  font-size: 28rpx;
  color: var(--brand-primary);
  font-weight: 900;
}

.picker-options {
  padding: 16rpx 0;
}

.picker-scroll {
  max-height: 560rpx;
  position: relative;
  padding-right: 60rpx;
}

/* 专业选择器：分组标题 */
.major-group-title {
  padding: 14rpx 32rpx 8rpx;
  color: var(--brand-primary);
  font-size: 22rpx;
  font-weight: 800;
  background: var(--brand-tint-2);
}

/* 右侧字母索引条 */
.major-index-bar {
  position: absolute;
  right: 6rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 0;
  z-index: 10;
  padding: 8rpx 4rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.index-letter {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 32rpx;
  font-size: 19rpx;
  color: var(--brand-deep);
  font-weight: 700;
  line-height: 1;
}

.picker-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
}

.picker-option:active {
  background: #f8fafc;
}

.picker-option.selected {
  background: var(--brand-tint);
}

.option-text {
  font-size: 30rpx;
  color: #0f172a;
}

.option-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: var(--brand-primary);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  color: #0f172a;
  font-size: 24rpx;
  background: var(--brand-tint-2);
  box-sizing: border-box;
}

.signature-textarea {
  min-height: 72rpx;
}

.tags-edit-area {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tags-display {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--brand-tint), var(--brand-soft));
  color: var(--brand-ink);
  font-size: 21rpx;
  font-weight: 800;
}

.tag-x {
  color: #f56c6c;
  font-size: 24rpx;
  font-weight: 900;
  margin-left: 2rpx;
}

.tag-add-row {
  display: flex;
  gap: 10rpx;
}

.tag-input {
  min-width: 0;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: var(--brand-tint-2);
  font-size: 22rpx;
  flex: 1;
}

.tag-add-btn {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  border-radius: 14rpx;
  color: #fff;
  background: var(--brand-bright);
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-desc {
  display: block;
  margin-top: -2rpx;
  margin-bottom: 12rpx;
  color: #94a3b8;
  font-size: 19rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  overflow: hidden;
}

.photo-thumb {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(245, 108, 108, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.del-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.photo-add-box {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  border: 2rpx dashed var(--brand-border);
  background: #f9fbfa;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 44rpx;
  color: #8ea898;
  font-weight: 300;
  line-height: 1;
}
