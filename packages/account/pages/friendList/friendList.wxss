.friendlist-page { animation: pageFadeIn 300ms ease; }
.friend-item { display: flex; align-items: center; padding: 22rpx 24rpx; cursor: pointer; }
.friend-item:active { background: rgba(0,0,0,0.02); }
.friend-avatar {
  width: 72rpx; height: 72rpx; border-radius: 999rpx; overflow: hidden;
  flex-shrink: 0; background: #e2e8f0; display: flex;
  align-items: center; justify-content: center;
}
.friend-avatar-img { width: 100%; height: 100%; }
.friend-avatar-text { color: #94a3b8; font-size: 30rpx; font-weight: 900; }
.friend-info { flex: 1; margin-left: 18rpx; min-width: 0; }
.friend-name { display: block; color: #0f172a; font-size: 26rpx; font-weight: 900; line-height: 1.3; }
.friend-id { display: block; margin-top: 4rpx; color: #94a3b8; font-size: 20rpx; }
.friend-remove-btn {
  height: 48rpx; padding: 0 16rpx; border-radius: 14rpx;
  color: #ef4444; font-size: 20rpx; font-weight: 800; background: #fef2f2;
  flex-shrink: 0;
}
.empty-state { margin-top: 18rpx; padding: 48rpx 24rpx; text-align: center; color: #94a3b8; font-size: 24rpx; }
