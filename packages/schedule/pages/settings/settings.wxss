/* ============================================
   课表管理设置页
   ============================================ */

.settings-page {
  min-height: 100vh;
  background: #f5f5f7;
  padding-bottom: 60rpx;
}

/* ----- 自定义导航栏 ----- */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  min-height: 88rpx;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 99;
}

.nav-back-icon {
  font-size: 48rpx;
  color: #1c1c1e;
  font-weight: 300;
  line-height: 1;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.nav-close-icon {
  font-size: 32rpx;
  color: #8e8e93;
  line-height: 1;
}

/* ----- 学期栏 ----- */
.semester-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: #ffffff;
}

.semester-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.semester-switch-btn {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #7b8cff, #a78bfa);
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ----- 提示框 ----- */
.tip-box {
  display: flex;
  align-items: center;
  margin: 12rpx 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f0f0f3;
}

.tip-avatar {
  font-size: 36rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 24rpx;
  color: #6e6e73;
  line-height: 1.4;
}

/* ----- 分区标题 ----- */
.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #8e8e93;
  padding: 28rpx 28rpx 10rpx;
}

/* ----- 设置组 ----- */
.setting-group {
  margin: 0 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  overflow: hidden;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 22rpx;
  border-bottom: 1rpx solid #f0f0f3;
}

.setting-row:last-child {
  border-bottom: none;
}

.setting-row-col {
  flex-direction: column;
  align-items: stretch;
}

.setting-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.setting-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1c1c1e;
}

.setting-value {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.setting-val-text {
  font-size: 26rpx;
  color: #8e8e93;
}

.setting-arrow {
  font-size: 32rpx;
  color: #c7c7cc;
  font-weight: 300;
}

.setting-hint {
  font-size: 22rpx;
  color: #aeaeb2;
  margin-top: 10rpx;
  line-height: 1.4;
}

.setting-row.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.setting-switch {
  transform: scale(0.85);
}

.ai-import-empty {
  padding: 28rpx 22rpx;
  color: #8e8e93;
  font-size: 24rpx;
  text-align: center;
}

.ai-import-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx;
  border-bottom: 1rpx solid #f0f0f3;
}

.ai-import-row:last-child {
  border-bottom: none;
}

.ai-import-copy {
  min-width: 0;
  flex: 1;
}

.ai-import-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 0 0 auto;
}

.ai-import-view,
.ai-import-delete {
  min-width: 118rpx;
  height: 52rpx;
  padding: 0 14rpx;
  border-radius: 14rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 50rpx;
}

.ai-import-view {
  color: var(--brand-deep);
  background: var(--brand-tint);
}

.ai-import-hint {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-import-delete {
  flex: 0 0 auto;
  min-width: 128rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(198, 64, 64, 0.22);
  border-radius: 16rpx;
  color: #c64040;
  background: #fffafa;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 54rpx;
}

.ai-import-view::after,
.ai-import-delete::after,
.import-detail-close::after,
.import-course-actions button::after {
  border: none;
}

.ai-import-delete:active {
  background: #fff0f0;
}

.danger-section-title,
.danger-label,
.danger-action {
  color: #668071;
}

.danger-group {
  border: 1rpx solid var(--brand-border);
  background: var(--brand-tint-2);
}

.clear-courses-row {
  border-bottom: none;
}

.danger-action {
  flex: 0 0 auto;
  padding-left: 20rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.import-detail-mask {
  position: fixed;
  inset: 0;
  z-index: 600;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.38);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.import-detail-sheet {
  width: 100%;
  max-height: 82vh;
  padding: 28rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: var(--brand-tint-2);
}

.import-detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.import-detail-head text,
.import-course-copy text {
  display: block;
}

.import-detail-title {
  color: var(--brand-ink);
  font-size: 32rpx;
  font-weight: 800;
}

.import-detail-subtitle {
  margin-top: 6rpx;
  color: #718077;
  font-size: 21rpx;
}

.import-detail-close {
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 16rpx;
  color: #5f7568;
  background: var(--brand-tint);
  font-size: 32rpx;
  line-height: 50rpx;
}

.import-detail-list {
  max-height: 66vh;
  margin-top: 22rpx;
}

.import-verification-section {
  margin-bottom: 18rpx;
  padding: 20rpx;
  border: 1rpx solid var(--brand-border);
  border-radius: 20rpx;
  background: #ffffff;
}

.import-verification-title,
.import-verification-note {
  display: block;
}

.import-verification-title {
  color: var(--brand-ink);
  font-size: 27rpx;
  font-weight: 800;
}

.import-verification-note {
  margin-top: 8rpx;
  color: #9b7a28;
  font-size: 21rpx;
  line-height: 1.45;
}

.import-verification-image {
  display: block;
  width: 100%;
  height: auto;
  margin-top: 14rpx;
  border-radius: 14rpx;
  background: #f6f7f8;
}

.import-course-row {
  margin-bottom: 14rpx;
  padding: 20rpx;
  border: 1rpx solid var(--brand-border);
  border-radius: 20rpx;
  background: #ffffff;
}

.import-course-title {
  color: var(--brand-ink);
  font-size: 27rpx;
  font-weight: 750;
}

.import-course-meta {
  margin-top: 7rpx;
  color: #718077;
  font-size: 21rpx;
  line-height: 1.4;
}

.import-course-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.import-course-actions button {
  flex: 1;
  height: 58rpx;
  border-radius: 16rpx;
  color: var(--brand-deep);
  background: var(--brand-tint);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.import-course-actions button.danger {
  color: #c64040;
  background: #fff0f0;
}

/* ----- 学期周数选择器 ----- */
.week-picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  background: rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.week-picker-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.week-picker-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f3;
}

.week-picker-cancel {
  font-size: 28rpx;
  color: #007aff;
}

.week-picker-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.week-picker-confirm {
  font-size: 28rpx;
  color: #007aff;
  font-weight: 600;
}

.week-picker-scroll {
  height: 420rpx;
}

.week-picker-inner {
  padding: 170rpx 0;
}

.week-picker-opt {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #aeaeb2;
  transition: all 150ms ease;
}

.week-picker-opt.active {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1c1e;
  background: rgba(0, 122, 255, 0.06);
}

/* ----- 日历选择器 ----- */
.cal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  background: rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.cal-sheet {
  width: 100%;
  max-height: 85vh;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  display: flex;
  flex-direction: column;
}

.cal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #f0f0f3;
  position: relative;
  flex-shrink: 0;
}

.cal-header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.cal-header-close {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
}

.cal-close-icon {
  font-size: 32rpx;
  color: #8e8e93;
}

.cal-scroll {
  flex: 1;
}

.cal-month-block {
  padding: 16rpx 0;
}

.cal-month-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1c1e;
  padding: 8rpx 28rpx;
  display: block;
}

.cal-weekdays {
  display: flex;
  padding: 6rpx 16rpx;
}

.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #8e8e93;
  font-weight: 500;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.cal-day {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #1c1c1e;
  border-radius: 50%;
}

.cal-day.empty {
  visibility: hidden;
}

.cal-day.selected {
  background: #007aff;
  color: #ffffff;
  font-weight: 700;
}

.cal-bottom {
  padding: 16rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.cal-confirm-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  background: #007aff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ----- 每周起始日选择器 ----- */
.ws-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 500;
  background: rgba(0, 0, 0, 0.35);
  backdrop-filter: blur(6rpx);
  -webkit-backdrop-filter: blur(6rpx);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.ws-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.ws-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f3;
}

.ws-cancel {
  font-size: 28rpx;
  color: #007aff;
}

.ws-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.ws-confirm {
  font-size: 28rpx;
  color: #007aff;
  font-weight: 600;
}

.ws-options {
  padding: 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ws-opt {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e8e8ed;
  transition: all 150ms ease;
}

.ws-opt.active {
  border-color: #007aff;
  background: #f5f9ff;
}

.ws-opt-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1c1e;
  display: block;
  margin-bottom: 14rpx;
}

.ws-opt.active .ws-opt-label {
  color: #007aff;
}

.ws-preview {
  display: flex;
  gap: 8rpx;
}

.ws-prev-item {
  width: 52rpx;
  height: 48rpx;
  border-radius: 10rpx;
  background: #f5f5f7;
  font-size: 22rpx;
  color: #8e8e93;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ws-opt.active .ws-prev-item {
  background: #e8f0fe;
  color: #007aff;
}

