<view style="{{themeVars}}" class="page add-schedule-page">
  <!-- ===== 顶部导航栏 ===== -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <!-- 左侧返回箭头 -->
    <view class="nav-left" bindtap="goBack">
      <text class="nav-back-icon">‹</text>
    </view>
    <!-- 中间标题 -->
    <text class="nav-title">添加日程</text>
    <!-- 右侧图标按钮组 -->
    <view class="nav-right">
      <view class="nav-icon-btn" bindtap="toggleStar">
        <text class="nav-icon {{starActive ? 'active' : ''}}">★</text>
      </view>
      <view class="nav-icon-btn" bindtap="openMoreMenu">
        <text class="nav-icon">⋯</text>
      </view>
      <view class="nav-icon-btn" bindtap="openSettings">
        <text class="nav-icon">⬡</text>
      </view>
    </view>
  </view>

  <!-- ===== 表单主体 ===== -->
  <view class="form-body">
    <!-- 日程名称 -->
    <view class="form-card">
      <input
        class="form-input name-input"
        value="{{form.title}}"
        bindinput="onTitleInput"
        placeholder="日程名称"
        placeholder-class="placeholder"
        maxlength="50"
      />
    </view>

    <!-- 时间选择行 -->
    <view class="form-card">
      <view class="form-row" bindtap="openTimePicker">
        <text class="row-label">开始时间 / 结束时间</text>
        <view class="row-right">
          <text class="row-value {{form.startTime ? '' : 'placeholder'}}">
            {{form.startTime ? form.startTime + ' - ' + form.endTime : '选择时间'}}
          </text>
          <text class="row-arrow">›</text>
        </view>
      </view>

      <!-- 分割线 -->
      <view class="row-divider"></view>

      <!-- 全天日程 -->
      <view class="form-row">
        <text class="row-label">全天日程</text>
        <view class="row-right">
          <switch
            checked="{{form.allDay}}"
            bindchange="onAllDayChange"
            color="{{themePrimary}}"
          />
        </view>
      </view>
    </view>

    <!-- 重复 -->
    <view class="form-card">
      <view class="form-row" bindtap="openRepeatPicker">
        <text class="row-label">重复</text>
        <view class="row-right">
          <text class="row-value">{{form.repeatLabel || '不重复'}}</text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 地点 -->
    <view class="form-card">
      <view class="form-row" bindtap="openLocationPicker">
        <text class="row-label">地点</text>
        <view class="row-right">
          <text class="row-value {{form.location ? '' : 'placeholder'}}">
            {{form.location || '添加地点'}}
          </text>
          <text class="row-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 描述文本框 -->
    <view class="form-card desc-card">
      <textarea
        class="form-textarea"
        value="{{form.description}}"
        bindinput="onDescInput"
        placeholder="添加日程描述"
        placeholder-class="placeholder"
        maxlength="1000"
        auto-height
      />
      <view class="desc-counter">{{descLength}}/1000</view>
    </view>
  </view>

  <!-- ===== 底部保存按钮 ===== -->
  <view class="bottom-bar">
    <button class="save-btn" bindtap="onSave">保存</button>
  </view>

  <!-- ===== 时间选择弹窗 ===== -->
  <view wx:if="{{timePickerOpen}}" class="modal-mask" bindtap="closeTimePicker">
    <view class="time-picker-sheet" catchtap="noop">
      <view class="picker-header">
        <text class="picker-cancel" bindtap="closeTimePicker">取消</text>
        <text class="picker-title">选择时间</text>
        <text class="picker-confirm" bindtap="confirmTime">确定</text>
      </view>
      <view class="picker-body">
        <view class="time-col">
          <text class="time-col-label">开始</text>
          <picker-view
            class="time-picker-view"
            value="{{startTimeIdx}}"
            bindchange="onStartTimeChange"
          >
            <picker-view-column>
              <view wx:for="{{hourOptions}}" wx:key="*this" class="picker-item">{{item}}</view>
            </picker-view-column>
            <picker-view-column>
              <view wx:for="{{minuteOptions}}" wx:key="*this" class="picker-item">{{item}}</view>
            </picker-view-column>
          </picker-view>
        </view>
        <view class="time-col">
          <text class="time-col-label">结束</text>
          <picker-view
            class="time-picker-view"
            value="{{endTimeIdx}}"
            bindchange="onEndTimeChange"
          >
            <picker-view-column>
              <view wx:for="{{hourOptions}}" wx:key="*this" class="picker-item">{{item}}</view>
            </picker-view-column>
            <picker-view-column>
              <view wx:for="{{minuteOptions}}" wx:key="*this" class="picker-item">{{item}}</view>
            </picker-view-column>
          </picker-view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 重复选择弹窗 ===== -->
  <view wx:if="{{repeatPickerOpen}}" class="modal-mask" bindtap="closeRepeatPicker">
    <view class="picker-sheet" catchtap="noop">
      <view class="picker-header">
        <text class="picker-cancel" bindtap="closeRepeatPicker">取消</text>
        <text class="picker-title">重复方式</text>
      </view>
      <view class="picker-list">
        <view
          wx:for="{{repeatOptions}}"
          wx:key="key"
          data-key="{{item.key}}"
          data-label="{{item.label}}"
          bindtap="selectRepeat"
          class="picker-option {{form.repeat === item.key ? 'selected' : ''}}"
        >
          <text>{{item.label}}</text>
          <text wx:if="{{form.repeat === item.key}}" class="option-check">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 地点手动输入弹窗 ===== -->
  <view wx:if="{{locationInputOpen}}" class="modal-mask" catchtap="closeLocationInput">
    <view class="location-input-sheet" catchtap="noop">
      <view class="picker-header">
        <text class="picker-cancel" bindtap="closeLocationInput">取消</text>
        <text class="picker-title">输入地点</text>
        <text class="picker-confirm" bindtap="confirmLocationInput">确定</text>
      </view>
      <view class="location-input-body">
        <input
          class="location-input-field"
          value="{{locationInputValue}}"
          bindinput="onLocationInput"
          placeholder="输入地点名称，如：图书馆、体育馆"
          placeholder-class="placeholder"
          focus="{{true}}"
        />
      </view>
    </view>
  </view>
</view>
