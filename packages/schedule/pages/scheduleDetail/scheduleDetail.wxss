.detail-page {
  min-height: 100vh;
  padding: 24rpx;
  animation: pageFadeIn 300ms ease;
}

.detail-content {
  animation: riseIn 300ms ease;
}

.review-alert {
  display: flex;
  align-items: flex-start;
  padding: 22rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(135deg, #fffbeb, #fef3c7);
  border-left: 6rpx solid #f59e0b;
}

.review-alert-icon {
  font-size: 42rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.review-alert-title {
  display: block;
  color: #92400e;
  font-size: 28rpx;
  font-weight: 900;
}

.review-alert-desc {
  display: block;
  margin-top: 8rpx;
  color: #a16207;
  font-size: 22rpx;
  line-height: 1.45;
}

.detail-header {
  display: flex;
  align-items: center;
  padding: 26rpx;
  margin-bottom: 18rpx;
  background: linear-gradient(135deg, var(--brand-tint), rgba(238, 250, 255, 0.96));
}

.detail-dot {
  width: 14rpx;
  height: 80rpx;
  margin-right: 20rpx;
  border-radius: 999rpx;
  background: var(--brand-bright);
  flex-shrink: 0;
}

.detail-title-block {
  min-width: 0;
}

.detail-title {
  display: block;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
  word-break: break-all;
}

.detail-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 800;
}

.info-card {
  padding: 10rpx 24rpx;
  margin-bottom: 24rpx;
}

/* 课程颜色选择器（与课表页编辑器色板一致） */
.color-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 12rpx 0 18rpx;
}

.color-swatch {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.color-swatch.active {
  border-color: #1c1c1e;
  box-shadow: 0 0 0 4rpx rgba(28, 28, 30, 0.15);
}

.color-swatch-auto {
  width: auto;
  min-width: 56rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #8e8e93;
  background: #f2f2f7;
}

/* 调色确认按钮 */
.color-confirm-btn {
  height: 64rpx;
  margin: 4rpx 0 18rpx;
  font-size: 26rpx;
}

.info-group-label {
  display: block;
  padding: 8rpx 0 6rpx;
  color: #94a3b8;
  font-size: 20rpx;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.info-value {
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 700;
  text-align: right;
  max-width: 60%;
  word-break: break-all;
}

.info-value.info-missing {
  color: #f59e0b;
  font-style: italic;
}

.info-value.status-ok {
  color: var(--brand-deep);
  font-size: 28rpx;
}

.info-value.status-warn {
  color: #dc2626;
  font-size: 28rpx;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
}

.detail-actions button {
  flex: 1;
  height: 80rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(15, 23, 42, 0.4);
  backdrop-filter: blur(8rpx);
}

.confirm-sheet {
  width: 100%;
  max-width: 560rpx;
  padding: 36rpx;
  border-radius: 28rpx;
  text-align: center;
  animation: panelPop 220ms ease;
}

.confirm-title {
  display: block;
  color: #0f172a;
  font-size: 30rpx;
  font-weight: 900;
}

.confirm-desc {
  display: block;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.confirm-buttons {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.confirm-buttons button {
  flex: 1;
  height: 72rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.primary-btn {
  color: var(--brand-ink);
  background: var(--brand-bright);
  border: none;
}

.primary-btn.danger {
  color: #fff;
  background: linear-gradient(135deg, #ef4444, #dc2626);
}

.ghost-btn {
  color: #64748b;
  background: #f1f5f9;
  border: none;
}

.ghost-btn.danger {
  color: #ef4444;
  background: #fef2f2;
}

.outline-btn {
  color: var(--brand-deep);
  background: transparent;
  border: 2rpx solid var(--brand-deep);
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
  color: #94a3b8;
  font-size: 26rpx;
}

.noop {
  /* empty */
}

@keyframes pageFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes panelPop {
  from {
    opacity: 0;
    transform: translateY(22rpx) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ============ 课程详情：Figma 25:590 / 25:921 还原 ============ */
.detail-page {
  /* 页面级颜色变量（本页统一色板，禁止多种相近绿/灰） */
  --page-background: #F4F4F4;
  --surface-background: #FFFFFF;
  --primary-green: #61B673;
  --light-green: #CCE8C9;
  --text-primary: #202020;
  --text-secondary: #A8A8A8;
  --text-caption: #B5B5B5;
  --card-border: #202020;
  --button-border: #858585;
  --divider-color: #F1F1F1;

  min-height: 100vh;
  padding: 0 18rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--page-background);
  animation: none;
}

.detail-content {
  animation: none;
}

/* ----- 自定义导航：返回箭头 + 左对齐标题，内容垂直居中 ----- */
.detail-nav {
  width: calc(100% + 36rpx);
  margin: 0 -18rpx;
  background: var(--surface-background);
}

.navigation-left {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
}

.navigation-left-hover {
  opacity: 0.6;
}

.back-icon {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #111111;
  border-bottom: 4rpx solid #111111;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.navigation-title {
  margin-left: 8rpx;
  color: #111111;
  font-size: 42rpx; /* 21px */
  font-weight: 500;
  line-height: 1;
}

/* ----- 课程卡：#CCE8C9、文字左上、三角 absolute ----- */
.detail-header {
  position: relative;
  display: flex;
  align-items: flex-start;
  min-height: 198rpx;
  margin: 16rpx 0 22rpx;
  padding: 26rpx 52rpx;
  overflow: visible;
  border: 3rpx solid var(--card-border);
  border-radius: 20rpx;
  color: #151515;
  background: var(--brand-primary);
  box-shadow: none;
}

.detail-header::before {
  position: absolute;
  left: calc(50% - 13rpx);
  bottom: -15rpx;
  width: 26rpx;
  height: 26rpx;
  border-right: 3rpx solid var(--card-border);
  border-bottom: 3rpx solid var(--card-border);
  background: var(--brand-primary);
  content: "";
  transform: rotate(45deg);
}

.detail-title-block {
  position: relative;
  z-index: 1;
  width: 100%;
}

.detail-title {
  color: #ffffff;
  font-size: 36rpx; /* 18px */
  font-weight: 700;
  line-height: 46rpx; /* 23px */
}

.detail-subtitle {
  display: block;
  margin-top: 18rpx; /* 9px */
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx; /* 12px */
  font-weight: 400;
  line-height: 30rpx; /* 15px */
}

/* ----- 信息卡：1.5px #202020 边、弱分组标题、浅分割线 ----- */
.info-card {
  margin-bottom: 22rpx;
  padding: 16rpx 24rpx 8rpx;
  border: 3rpx solid var(--card-border);
  border-radius: 22rpx; /* 11px */
  background: var(--surface-background);
  box-shadow: none;
  overflow: hidden;
}

.info-group-label {
  display: block;
  padding: 0;
  color: var(--text-caption);
  font-size: 22rpx; /* 11px */
  font-weight: 400;
  line-height: 30rpx; /* 15px */
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx; /* 36px */
  padding: 10rpx 0;
  border-bottom: 2rpx solid var(--divider-color); /* 1px #F1F1F1 */
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  flex-shrink: 0;
  color: var(--text-secondary);
  font-size: 24rpx; /* 12px */
  font-weight: 400;
  line-height: 32rpx; /* 16px */
}

.info-value {
  max-width: 68%;
  color: var(--text-primary);
  font-size: 24rpx; /* 12px */
  font-weight: 600;
  line-height: 32rpx; /* 16px */
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.info-value.info-missing {
  color: #f59e0b;
  font-style: italic;
}

.info-value.status-ok {
  color: var(--text-primary);
  font-size: 24rpx;
}

.info-value.status-warn {
  color: #dc2626;
  font-size: 24rpx;
}

/* ----- 删除 / 编辑按钮 ----- */
.detail-actions {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin: 8rpx 0 0;
}

.detail-main-actions {
  display: flex;
  gap: 56rpx; /* ≈ 页面宽 7.5% */
}

.detail-main-actions button {
  flex: 1;
  height: 104rpx;
  margin: 0;
  border-radius: 19rpx; /* 9.5px */
  font-size: 35rpx; /* 17.5px */
  font-weight: 500;
}

.delete-btn {
  border: 4rpx solid var(--button-border); /* 2px #858585 */
  color: #151515;
  background: var(--surface-background);
}

.edit-btn {
  border: 0;
  color: #fff;
  background: var(--brand-primary);
  font-weight: 500;
}

/* ----- 回到日视图：82% 宽胶囊（0-1-1 选择器压过旧 .detail-actions button 规则） ----- */
.detail-actions .back-day-btn {
  box-sizing: border-box;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82vw;
  min-height: 62rpx; /* 31px */
  height: auto;
  margin: 16rpx auto 0;
  padding: 6rpx 32rpx;
  border: 4rpx solid var(--button-border); /* 2px #858585 */
  border-radius: 999rpx;
  color: #fff;
  background: var(--brand-primary);
  font-size: 36rpx; /* 18px */
  font-weight: 600;
  line-height: 44rpx; /* 22px */
}

.delete-btn::after,
.edit-btn::after,
.back-day-btn::after {
  border: 0;
}

.review-alert {
  border: 0;
  border-radius: 22rpx;
  background: #fff2cf;
  box-shadow: none;
}

.confirm-sheet {
  border: 0;
  border-radius: 30rpx;
  background: #ffffff;
}
