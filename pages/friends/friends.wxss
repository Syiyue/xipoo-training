/* ===== 页面底部安全区 ===== */
.friends-page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

/* ==================== 通用卡片 ==================== */
.section-card {
  border-radius: 20rpx;
  box-shadow: 0 18rpx 44rpx rgba(70, 70, 100, .12);
  overflow: hidden;
}

.section-block {
  margin-top: 28rpx;
}

.section-title {
  display: block;
  color: var(--brand-ink);
  font-size: 31rpx;
  font-weight: 900;
}

.section-note {
  display: block;
  margin-top: 5rpx;
  color: #78877e;
  font-size: 22rpx;
  line-height: 1.4;
}

/* ==================== 分区一：个人主页入口 ==================== */
.profile-entry-card {
  padding: 30rpx;
  color: var(--brand-ink);
}

.profile-entry-card.theme-mint { background: linear-gradient(135deg, var(--brand-bright), var(--brand-tint)); }
.profile-entry-card.theme-sky { background: linear-gradient(135deg, #8bd4f6, #e6f6ff); }
.profile-entry-card.theme-coral { background: linear-gradient(135deg, #ffaaa0, #fff0ed); }
.profile-entry-card.theme-graphite { color: #fff; background: linear-gradient(135deg, #34423a, #718078); }

.pe-top {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.pe-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  color: var(--brand-ink);
  background: rgba(255,255,255,.72);
  font-size: 36rpx;
  font-weight: 900;
  overflow: hidden;
}
.pe-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.pe-identity {
  min-width: 0;
  flex: 1;
}

.pe-name {
  display: block;
  font-size: 34rpx;
  font-weight: 900;
}

.pe-id {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  opacity: .72;
}

.pe-arrow {
  font-size: 46rpx;
  font-weight: 200;
  opacity: .55;
  line-height: 1;
}

.pe-signature {
  display: block;
  margin-top: 22rpx;
  font-size: 25rpx;
  line-height: 1.5;
  font-weight: 800;
}

.pe-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255,255,255,.36);
}

.pe-footer text:first-child {
  font-size: 20rpx;
  font-weight: 900;
  opacity: .72;
}

.pe-hint {
  font-size: 18rpx;
  opacity: .55;
}

/* ==================== 分区二：多人共同空闲 ==================== */
.free-time-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 32rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  min-height: 176rpx;
  background: #fff;
  box-shadow: 0 12rpx 34rpx rgba(70, 70, 100, .07);
  z-index: 1;
}

/* 长条背景图：铺满整卡，左侧留白保证文字可读，右侧渐隐露出插画 */
.ft-card-art {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.free-time-card::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.94) 0%, rgba(255, 255, 255, 0.62) 52%, rgba(255, 255, 255, 0.12) 100%);
  pointer-events: none;
}

.ft-icon-wrap,
.ft-info,
.ft-arrow {
  position: relative;
  z-index: 1;
}

/* 黑夜模式：压暗背景图，改用深色遮罩保证浅色文字可读 */
.dark-mode .ft-card-art {
  filter: brightness(0.55) saturate(0.85);
}

.dark-mode .free-time-card::after {
  background: linear-gradient(90deg, rgba(24, 26, 32, 0.92) 0%, rgba(24, 26, 32, 0.6) 52%, rgba(24, 26, 32, 0.12) 100%);
}

.ft-icon-wrap {
  flex: 0 0 auto;
}

.ft-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, var(--brand-tint), var(--brand-soft));
  font-size: 40rpx;
}

.ft-info {
  min-width: 0;
  flex: 1;
}

.ft-title {
  display: block;
  color: var(--brand-ink);
  font-size: 28rpx;
  font-weight: 900;
}

.ft-desc {
  display: block;
  margin-top: 6rpx;
  color: #6b7c72;
  font-size: 21rpx;
  line-height: 1.45;
}

.ft-arrow {
  font-size: 42rpx;
  color: #b0c0b6;
  font-weight: 200;
}

/* ==================== 分区三：ID搜索 ==================== */
.search-box {
  display: flex;
  margin-top: 15rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(70, 70, 100, .07);
}

.friend-search-input {
  min-width: 0;
  height: 70rpx;
  padding: 0 18rpx;
  flex: 1;
  font-size: 24rpx;
}

.friend-search-button {
  width: 116rpx;
  height: 70rpx;
  border-radius: 12rpx;
  color: var(--brand-ink);
  background: var(--brand-primary);
  font-size: 23rpx;
  font-weight: 900;
}

.result-list {
  margin-top: 16rpx;
}

.person-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #fff;
}

.small-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  color: var(--brand-ink);
  background: var(--brand-tint);
  font-size: 28rpx;
  font-weight: 900;
  overflow: hidden;
}
.small-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.person-main {
  min-width: 0;
  flex: 1;
}

.person-main text:first-child {
  display: block;
  color: var(--brand-ink);
  font-size: 25rpx;
  font-weight: 900;
}

.person-main text:last-child {
  display: block;
  margin-top: 5rpx;
  color: #7a8980;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.person-row > button {
  min-width: 104rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  color: var(--brand-ink);
  background: var(--brand-tint);
  font-size: 21rpx;
  font-weight: 900;
}

.person-row > button.added-btn {
  color: #8e9992;
  background: var(--brand-tint-2);
}

.person-row > button.pending-btn {
  color: #9b8650;
  background: #fef9ed;
}

/* ==================== 分区四：我的好友列表 ==================== */
.section-head-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.friend-count {
  color: #78877e;
  font-size: 22rpx;
  font-weight: 800;
}

.request-badge {
  min-width: auto;
  height: 42rpx;
  padding: 0 16rpx;
  margin-left: auto;
  border-radius: 999rpx;
  color: #fff;
  background: linear-gradient(135deg, #ff8a6e, #f05d3e);
  font-size: 19rpx;
  font-weight: 900;
}

.friend-list {
  margin-top: 16rpx;
}

.friend-row {
  padding: 24rpx;
  margin-bottom: 22rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(70, 70, 100, .06);
}

.friend-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.friend-info-block {
  min-width: 0;
  flex: 1;
}

.friend-name {
  display: block;
  color: var(--brand-ink);
  font-size: 25rpx;
  font-weight: 900;
}

.friend-bio {
  display: block;
  margin-top: 4rpx;
  color: #7a8980;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.open-profile {
  color: var(--brand-deep);
  font-size: 22rpx;
  font-weight: 900;
}

.share-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--brand-border);
}

.share-label text:first-child {
  display: block;
  color: var(--brand-ink);
  font-size: 21rpx;
  font-weight: 800;
}

.share-status {
  display: block;
  margin-top: 4rpx;
  color: #87938c;
  font-size: 18rpx;
}

.share-status.active {
  color: var(--brand-deep);
}

/* ==================== 好友申请弹窗 ==================== */
.modal-mask {
  position: fixed;
  z-index: 60;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(17,34,25,.46);
}

.request-panel {
  width: 100%;
  max-height: 70vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
}

.request-list {
  margin-top: 8rpx;
}

.request-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: var(--brand-tint-2);
}

.request-row > button {
  min-width: 52rpx;
  width: 52rpx;
  height: 52rpx;
  padding: 0;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}
.reject-btn { color: #fff; background: #f56c6c; }
.accept-btn { color: #fff; background: var(--brand-bright); }

.request-message {
  display: block;
  margin-top: 4rpx;
  color: #9a9a9a;
  font-size: 19rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 360rpx;
}

/* ==================== 个人主页编辑弹窗 ==================== */
.profile-editor {
  width: 100%;
  max-height: 90vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
}

.editor-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.editor-head > text {
  color: var(--brand-ink);
  font-size: 31rpx;
  font-weight: 900;
}

.rp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  position: relative;
}

.rp-head text {
  color: var(--brand-ink);
  font-size: 31rpx;
  font-weight: 900;
}

.close-btn {
  position: absolute;
  top: 0;
  right: 0;
  padding: 10rpx 20rpx;
  border-radius: 10rpx;
  background: #f0f2f5;
  color: #6b7c73;
  font-size: 22rpx;
  font-weight: 700;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.form-row {
  margin-top: 24rpx;
}

.form-row > text {
  display: block;
  margin-bottom: 8rpx;
  color: #465a4e;
  font-size: 21rpx;
  font-weight: 800;
}

.form-row input,
.form-row textarea,
.tag-input input,
.picker-value {
  width: 100%;
  padding: 18rpx;
  border-radius: 12rpx;
  background: var(--brand-tint-2);
  font-size: 23rpx;
}

.form-row textarea {
  height: 126rpx;
}

.picker-value {
  color: var(--brand-ink);
  font-weight: 800;
}

.form-label {
  display: block;
  margin-top: 22rpx;
  color: #465a4e;
  font-size: 21rpx;
  font-weight: 800;
}

.theme-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.theme-picker button {
  min-height: 54rpx;
  padding: 0 16rpx;
  border: 3rpx solid transparent;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.theme-picker button.active {
  border-color: var(--brand-ink);
}

.visibility-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  border-bottom: 1rpx solid var(--brand-border);
  color: var(--brand-ink);
  font-size: 22rpx;
}

.visibility-switch {
  transform: scale(0.75);
}

.save-profile {
  margin-top: 24rpx;
}

/* ==================== 好友操作区（隐藏 & 删除） ==================== */
.friend-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid var(--brand-border);
}

.action-hide {
  color: #8e9590;
  font-size: 21rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
}

.action-delete {
  color: #e88b8b;
  font-size: 21rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
}

/* ==================== 已隐藏好友入口 ==================== */
.hidden-entry {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx;
  margin-top: 12rpx;
  border-radius: 16rpx;
  background: var(--brand-tint-2);
}

.hidden-icon {
  font-size: 28rpx;
}

.hidden-label {
  flex: 1;
  color: #58635d;
  font-size: 23rpx;
  font-weight: 800;
}

.hidden-count {
  color: #fff;
  background: #9ba5a0;
  border-radius: 50%;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 19rpx;
  font-weight: 900;
}

.hidden-arrow {
  color: #bcc5c0;
  font-size: 36rpx;
  font-weight: 200;
}

/* ==================== 恢复按钮 ==================== */
.restore-btn {
  min-width: 104rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  color: var(--brand-deep);
  background: var(--brand-tint);
  font-size: 21rpx;
  font-weight: 900;
}
.figma-page-header { margin-bottom: 16rpx; }
.section-card,
.section-block,
.friend-row,
.person-row {
  border: 2rpx solid var(--brand-primary);
  border-radius: 30rpx;
  background: #f4f4f4;
  box-shadow: none;
}
.search-box { border-radius: 30rpx; background: #ffffff; }
.friend-search-button { border-radius: 30rpx; color: #ffffff; background: var(--brand-primary); }
.share-control { border-radius: 30rpx; background: #ffffff; }

/* 好友页布局修正：分区标题不再套外框，卡片只保留一层边界。 */
.section-block {
  margin-top: 32rpx;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.section-title {
  font-size: 30rpx;
  line-height: 1.35;
}

.section-note {
  margin-top: 6rpx;
  line-height: 1.5;
}

.search-box {
  margin-top: 18rpx;
  padding: 8rpx;
  border: 2rpx solid var(--brand-primary);
  background: #ffffff;
}

.friend-list {
  margin-top: 18rpx;
}

.friend-row {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 2rpx solid var(--brand-primary);
  background: #f4f4f4;
}

.share-control {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-top: 0;
  border-radius: 24rpx;
  background: #ffffff;
}

.friend-actions {
  margin-top: 8rpx;
  padding-top: 4rpx;
  border-top: 0;
}

.action-hide,
.action-delete {
  padding: 8rpx 12rpx;
}

/* 个人入口不再沿用旧版可变渐变主题，统一到 Figma 的平面绿色。 */
.profile-entry-card,
.profile-entry-card.theme-mint,
.profile-entry-card.theme-sky,
.profile-entry-card.theme-coral,
.profile-entry-card.theme-graphite {
  color: #212121;
  border: 2rpx solid var(--brand-primary);
  background: var(--brand-soft);
  box-shadow: none;
}

.free-time-card {
  border-width: 2rpx;
  background: #ffffff;
}

.search-box,
.friend-row,
.person-row {
  border-width: 2rpx;
}

/* ========== 第二张参考图：好友页精确布局 ========== */
.friends-page {
  padding-top: 0;
  background: #f4f4f4;
}

.friends-nav {
  box-sizing: content-box;
  width: calc(100% + 40rpx);
  height: 88rpx;
  margin: 0 -20rpx;
  padding-bottom: 12rpx;
  display: flex;
  align-items: center;
  background: transparent;
}

.friends-nav-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding-left: 16rpx;
  color: #000000;
}

.friends-nav-label {
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1;
}

.home-line-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
}

/* 子视图返回箭头（与小房子图标同槽位） */
.nav-back-arrow {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1e1e1e;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1;
}

.home-line-roof {
  position: absolute;
  top: 7rpx;
  left: 6rpx;
  width: 34rpx;
  height: 34rpx;
  border-top: 6rpx solid #1e1e1e;
  border-left: 6rpx solid #1e1e1e;
  border-radius: 3rpx 0 0;
  transform: rotate(45deg);
}

.home-line-body {
  position: absolute;
  left: 9rpx;
  bottom: 2rpx;
  width: 31rpx;
  height: 28rpx;
  border: 6rpx solid #1e1e1e;
  border-top: 0;
  border-radius: 2rpx;
}

.section-card,
.profile-entry-card,
.free-time-card,
.person-row {
  box-shadow: none;
}

.profile-entry-card,
.profile-entry-card.theme-mint,
.profile-entry-card.theme-sky,
.profile-entry-card.theme-coral,
.profile-entry-card.theme-graphite {
  margin-top: 12rpx;
  padding: 18rpx 20rpx 20rpx;
  border: 0;
  border-radius: 20rpx;
  color: #212121;
  background: var(--brand-primary);
}

.pe-top {
  min-height: 150rpx;
  gap: 30rpx;
}

.pe-avatar {
  width: 150rpx;
  height: 150rpx;
  border: 5rpx solid #ffffff;
  color: #606060;
  background: #dedede;
  font-size: 42rpx;
}

.pe-name {
  color: var(--on-brand);
  font-size: 43rpx;
  font-weight: 600;
  line-height: 1.15;
}

.pe-id {
  margin-top: 6rpx;
  color: #ffffff;
  font-size: 24rpx;
  opacity: 1;
}

.pe-meta {
  display: block;
  margin-top: 7rpx;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 1.2;
}

.pe-arrow {
  color: var(--on-brand);
  font-size: 68rpx;
  font-weight: 400;
  opacity: 1;
}

.pe-signature {
  height: 68rpx;
  margin-top: 16rpx;
  padding: 0 44rpx;
  display: flex;
  align-items: center;
  border: 4rpx solid #555555;
  border-radius: 34rpx;
  color: #888888;
  background: #f4f4f4;
  font-size: 23rpx;
  font-weight: 400;
  line-height: 1;
}

.free-time-card {
  min-height: 208rpx;
  gap: 22rpx;
  margin-top: 14rpx;
  padding: 30rpx 28rpx;
  border: 2rpx solid var(--brand-primary);
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--brand-tint) 0%, #ffffff 70%);
  box-shadow: 0 10rpx 28rpx var(--brand-soft);
}

.ft-icon {
  width: 108rpx;
  height: 108rpx;
  border-radius: 24rpx;
  background: var(--brand-tint-2, var(--brand-tint));
  font-size: 52rpx;
}

.ft-title {
  color: #212121;
  font-size: 33rpx;
  font-weight: 800;
}

.ft-desc {
  margin-top: 6rpx;
  color: #6a6a6a;
  font-size: 22rpx;
  line-height: 1.4;
}

.ft-arrow {
  color: var(--brand-primary);
  font-size: 46rpx;
}

.friend-tools {
  width: calc(100% + 40rpx);
  height: 82rpx;
  margin: 0 -20rpx;
  padding-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 22rpx;
  border-bottom: 1rpx solid #eeeeee;
  background: #ffffff;
}

.friend-tool-button {
  position: relative;
  width: 54rpx;
