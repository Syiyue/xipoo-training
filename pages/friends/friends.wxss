  display: block;
  margin-top: 6rpx;
}
.group-card-del {
  color: #a4aaa6;
  font-size: 28rpx;
  padding: 12rpx;
}

/* ----- 页面背景图（fixed 垫底，盖住页面底色） ----- */
.friends-page {
  background: none;
}

.page-bg-image {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

/* ----- 空态卡片：加半透明白底，避免背景图干扰文字阅读 ----- */
.contact-empty {
  background: rgba(255, 255, 255, 0.86);
  border-radius: 28rpx;
  margin: 0 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 131, 199, 0.1);
}

.contact-empty-desc {
  color: #5f655f;
}

.contact-empty-secondary {
  font-weight: 600;
}

/* ----- 黑夜模式：压暗背景图融入深色底 ----- */
.dark-mode .page-bg-image {
  opacity: 1;
  filter: brightness(0.15) saturate(0.6);
}

.friends-page.dark-mode {
  background: none;
}

.dark-mode .contact-empty {
  background: var(--card-bg);
  box-shadow: none;
}

.dark-mode .contact-empty-desc {
  color: var(--text-secondary);
}

/* 日程共享主视图：使用提供的夜读插画与日历横幅，仍保留完整的邀请和精确检索交互。 */
.add-friend-view {
  position: relative;
  overflow: hidden;
  background: rgba(248, 248, 250, 0.9);
}

.add-friend-view .friend-view-tabs,
.add-friend-view .invite-primary-card,
.add-friend-view .add-by-id {
  position: relative;
  z-index: 1;
}

.invite-primary-card {
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 14rpx 40rpx rgba(71, 65, 137, 0.1);
}

.share-invite-banner {
  display: block;
  width: calc(100% + 64rpx);
  height: 154rpx;
  margin: -32rpx -32rpx 24rpx;
  border-radius: 28rpx 28rpx 0 0;
}

.schedule-share-search-box {
  height: 104rpx;
  overflow: hidden;
  border: 0;
  border-radius: 24rpx;
  background: transparent;
  box-shadow: 0 8rpx 20rpx rgba(88, 78, 161, 0.12);
}

.schedule-share-search-art {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.schedule-share-search-box .subpage-search-input {
  position: relative;
  z-index: 1;
  width: auto;
  height: 104rpx;
  padding: 0 126rpx 0 190rpx;
  color: #3f3a57;
  font-size: 23rpx;
}

.schedule-share-search-box .search-line-icon {
  top: 0;
  right: 0;
  z-index: 2;
  width: 112rpx;
  height: 104rpx;
  border: 0;
  border-radius: 0;
}

.schedule-share-search-box .search-line-icon::after {
  display: none;
}

.share-calendar-deco {
  display: block;
  width: 280rpx;
  margin: 26rpx auto 8rpx;
  opacity: 0.76;
}

.dark-mode .add-friend-view {
  background: rgba(15, 18, 30, 0.92);
}

.dark-mode .share-invite-banner,
.dark-mode .share-calendar-deco {
  opacity: 0.52;
  filter: brightness(0.76) saturate(0.6);
}

/* ----- 黑夜模式整改 ----- */
.dark-mode .friends-nav-label {
  color: var(--text-primary);
}

.dark-mode .home-line-roof {
  border-top-color: #e2e8f0;
  border-left-color: #e2e8f0;
}

.dark-mode .home-line-body {
  border-color: #e2e8f0;
  border-top: 0;
}

.dark-mode .section-card,
.dark-mode .friend-row,
.dark-mode .person-row {
  background: var(--card-bg);
  border-color: var(--card-border);
}

.dark-mode .ft-title,
.dark-mode .friend-name {
  color: var(--text-primary);
}

.dark-mode .ft-desc,
.dark-mode .friend-id-line {
  color: var(--text-secondary);
}

/* 暗色模式：空态提示用深色卡片底，浅色文字；避免浅色文字落在半透明白条上像被「切割」 */
.dark-mode .tab-empty-hint {
  color: var(--text-secondary);
  background: var(--card-bg);
  border: 1rpx solid var(--card-border);
}

/* ----- 黑夜模式：工具行去白底，图标提亮 ----- */
.dark-mode .friend-tools {
  background: transparent;
  border-bottom-color: var(--divider-color);
}

.dark-mode .friend-tool-icon {
  filter: invert(85%);
}

.dark-mode .section-title {
  color: var(--text-primary);
}

