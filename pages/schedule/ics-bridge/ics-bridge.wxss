/* ics-bridge.wxss — iOS 日历导入中转页样式 */

.bridge-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 48rpx 36rpx;
  background: #f5f5f7;
  box-sizing: border-box;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #6366F1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #888;
}

/* 降级引导页 */
.fallback-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.fallback-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.fallback-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1e1e1e;
  margin-bottom: 20rpx;
  text-align: center;
}

.fallback-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.fallback-btn {
  width: 100%;
  background: #6366F1;
  color: #fff;
  font-size: 30rpx;
  border-radius: 12rpx;
  padding: 24rpx 0;
  text-align: center;
  margin-bottom: 24rpx;
}

.fallback-btn::after {
  border: none;
}

.fallback-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  line-height: 1.5;
}

.steps {
  width: 100%;
  margin: 4rpx 0 34rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f1f2fb;
  box-sizing: border-box;
}

.steps text { display: block; margin-top: 10rpx; color: #596174; font-size: 24rpx; line-height: 1.45; }
.steps text:first-child { margin-top: 0; }
