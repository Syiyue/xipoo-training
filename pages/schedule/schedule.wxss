}
.month-week-text { display: block; width: 100%; font-size: 15rpx; line-height: 1.2; opacity: .9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.editor-course-marker { margin-top: 4rpx; padding: 2rpx 4rpx; max-width: 100%; color: #fff; background: var(--brand-primary); border-radius: 5rpx; font-size: 14rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.form-row text {
  display: block;
  margin-bottom: 10rpx;
  color: #8e8e93;
  font-size: 22rpx;
  font-weight: 500;
}

.form-row input,
.picker-value {
  height: 78rpx;
  padding: 0 20rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  color: #1c1c1e;
  font-size: 24rpx;
  background: #f8f8fa;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

/* 课程标题必填校验：未填写时红色提示 + 输入框红框 */
.field-required-hint {
  color: #d94b4b;
  font-size: 20rpx;
  font-weight: 600;
}

.input-error {
  border: 2rpx solid #d94b4b !important;
  background: #fff5f5;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.editor-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.editor-actions button {
  flex: 1;
  height: 76rpx;
  border-radius: 30rpx;
  font-weight: 600;
}

.editor-actions .danger {
  color: #ff3b30;
}

.course-confirm-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 112rpx;
  padding-top: 34rpx;
  color: #8e8e93;
  font-size: 22rpx;
  font-weight: 500;
}

@keyframes panelPop {
  from {
    opacity: 0;
    transform: translateY(22rpx) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* ----- 右下角 FAB 加号按钮 ----- */
.fab-wrapper {
  position: fixed;
  bottom: calc(148rpx + env(safe-area-inset-bottom));
  right: 40rpx;
  z-index: 150;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.fab-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 8rpx 28rpx rgba(39, 155, 89, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

.fab-btn:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(39, 155, 89, 0.2);
}

.fab-icon {
  font-size: 52rpx;
  color: #ffffff;
  font-weight: 400;
  line-height: 1;
}

.fab-popup {
  position: absolute;
  bottom: calc(100% + 12rpx);
  right: 0;
  min-width: 260rpx;
  padding: 10rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  animation: panelPop 200ms ease;
}

/* schedule 新版匹配入口 */
.match-entry-cards { margin-top: 16rpx; display: flex; flex-direction: column; gap: 14rpx; }
.match-entry-card { display: flex; align-items: center; padding: 26rpx 24rpx; border-radius: 20rpx; background: rgba(255, 255, 255, 0.94); box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06); transition: transform 180ms ease, box-shadow 180ms ease; }
.match-entry-card:active { transform: scale(0.985); box-shadow: 0 14rpx 36rpx rgba(15, 23, 42, 0.1); }
.entry-icon { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; font-size: 36rpx; flex-shrink: 0; }
.buddy-icon { background: linear-gradient(135deg, var(--brand-tint), var(--brand-soft)); }
.course-icon { background: linear-gradient(135deg, #e8f0ff, #d9e8ff); }
.time-icon { background: linear-gradient(135deg, #fff8e8, #ffe8d9); }
.entry-text { flex: 1; min-width: 0; margin-left: 20rpx; }
.entry-name { display: block; color: #0f172a; font-size: 30rpx; font-weight: 900; }
.entry-desc { display: block; margin-top: 6rpx; color: #64748b; font-size: 22rpx; }
.entry-arrow { font-size: 34rpx; color: #cbd5e1; font-weight: 300; flex-shrink: 0; }
.match-guide-bubble { margin-top: 22rpx; padding: 22rpx 26rpx; border-radius: 18rpx; background: linear-gradient(135deg, var(--brand-tint), #ecfeff); box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06); text-align: center; }
.guide-text { color: #334155; font-size: 25rpx; font-weight: 700; line-height: 1.5; }
.guide-dots { display: flex; justify-content: center; gap: 10rpx; margin-top: 16rpx; }
.guide-dot { width: 10rpx; height: 10rpx; border-radius: 999rpx; background: #cbd5e1; }
.guide-dot.active { background: var(--brand-bright); transform: scale(1.4); }

/* Figma 匹配入口最终覆盖（需位于旧版样式之后）。 */
.match-entry-cards { gap: 20rpx; }
.match-entry-card {
