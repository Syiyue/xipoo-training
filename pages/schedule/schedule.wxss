/* 主切换与日/周/月切换在设计中均为通栏平面分段控件。 */
.top-tabs,
.range-switch {
  width: calc(100% + 40rpx);
  margin-right: -20rpx;
  margin-left: -20rpx;
  border-radius: 0;
  background: #ffffff;
  box-shadow: none;
}

.top-tabs {
  padding: 8rpx 20rpx;
}

.range-switch {
  padding: 6rpx 20rpx;
}

.top-tabs .tab-btn.active {
  color: #212121;
  background: var(--brand-soft);
  box-shadow: none;
}

/* Figma：日/周/月选中项为实心绿底白字。 */
.range-btn.active {
  color: #ffffff;
  background: var(--brand-primary);
  box-shadow: none;
