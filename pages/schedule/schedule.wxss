.entry-desc { color: #757575; }
.match-guide-bubble { border-radius: 30rpx; background: var(--brand-soft); box-shadow: none; }
.guide-dot.active { background: var(--brand-primary); }

/* 匹配入口精确还原 Figma 内嵌卡片：白底、灰边、三种语义色图标。 */
.match-view {
