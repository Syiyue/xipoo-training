/* ============================================================
   Figma 还原最终覆盖（2026-07 视觉对齐）
   目标：纯色日期卡 #61B673 / 浅绿 #CCE8C9 选中态 /
   外框 #CAC4D0 / 网格线 #F4F4F4 / 紧凑顶部控制区 / 动态时间轴
   ============================================================ */

/* ----- 1. 日期卡：纯色、紧凑高度、大圆角、白色层级文字 ----- */
.date-card {
  min-height: 158rpx; /* 较 236rpx 缩减约 1/3，保持风格不变更紧凑 */
  margin: 16rpx 12rpx 0;
  padding: 16rpx 20rpx;
  border: 0;
  border-radius: 40rpx;
  background: var(--color-primary);
  box-shadow: none;
}

.date-nav-btn {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 100%;
  color: #ffffff;
  font-size: 44rpx;
  line-height: 1;
}

.date-nav-btn:active {
  background: rgba(255, 255, 255, 0.16);
}

.date-picker-content {
  min-height: 120rpx;
  padding: 8rpx 24rpx;
}

.date-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx; /* 11px */
  font-weight: 400;
  line-height: 1.25;
}

.date-value {
  margin-top: 16rpx; /* 与上方小标题拉开呼吸感 */
  color: #ffffff;
  font-family: 'PingFang SC', monospace;
  font-size: 38rpx; /* 19px，等宽字体；英文长日期不换行 */
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.date-side {
  padding-left: 40rpx; /* 与左侧日期组拉开间距 */
  flex-shrink: 0;
}

.date-side .date-weekday {
  color: #ffffff;
  font-size: 48rpx; /* 24px */
  font-weight: 600;
  line-height: 1.25;
}

.date-side .date-hint {
  margin-top: 16rpx; /* 星期与提示语拉开呼吸感 */
  color: rgba(255, 255, 255, 0.6);
  font-size: 18rpx; /* 9px，英文长提示也不挤压日期 */
  font-weight: 400;
  line-height: 1.25;
  max-width: 200rpx;
  text-align: right;
}

/* ----- 2. 课程表/匹配：浅绿胶囊选中，按钮更宽更高更易点 ----- */
.top-tabs {
  padding: 10rpx 12rpx; /* 减小轨道内边距，让两个按钮区域更宽 */
}

.top-tabs .tab-btn {
  height: 60rpx; /* 30px，加大可点区域 */
  border-radius: 30rpx;
  color: var(--color-text-primary);
  font-size: 32rpx; /* 16px */
  font-weight: 500;
  box-shadow: none;
}

.top-tabs .tab-btn.active {
  color: var(--color-text-primary);
  background: var(--color-primary-soft);
  font-weight: 500;
  box-shadow: none;
}

.top-tabs .tab-btn.active::after {
  display: none;
}

/* ----- 3. 日/周/月：绿实底白字胶囊，行高压缩 ----- */
.range-switch {
  padding: 4rpx 20rpx 8rpx;
}

.range-btn {
  height: 48rpx;
  border-radius: 24rpx;
  color: var(--color-text-primary);
  font-size: 32rpx; /* 16px */
  font-weight: 500;
}

.range-btn.active {
  color: #ffffff;
  background: var(--color-primary);
  font-weight: 500;
  box-shadow: none;
}

/* ----- 4. 周数工具栏：#CCE8C9 底、压缩高度 ----- */
.semester-bar {
  min-height: 64rpx;
  margin-top: 12rpx;
  padding: 8rpx 28rpx;
  background: var(--color-primary-soft);
  border: 0;
  border-radius: 20rpx;
}

.semester-week {
  font-size: 38rpx; /* 19px */
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1;
}

.semester-arrow {
  font-size: 16rpx;
  color: #7a887c;
}

.semester-month {
  font-size: 24rpx; /* 12px，更明显 */
  font-weight: 600;
  color: var(--color-text-primary);
  padding-left: 16rpx;
}

.semester-actions {
  gap: 28rpx;
  right: 28rpx;
}

.icon-btn {
  width: 40rpx;
  height: 40rpx;
}

/* AI 录入入口徽标 */
.ico-ai-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  letter-spacing: 1rpx;
  line-height: 1;
}

/* 时钟 / 分享 / 设置 线性图标（stroke 2px ≈ 1.8px@20px 视觉） */
.ico {
  width: 38rpx;
  height: 38rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.ico-clock {
  background-image: url("data:image/svg+xml;base64,");
}

.ico-bell {
  background-image: url("data:image/svg+xml;base64,");
}

.ico-share {
  background-image: url("data:image/svg+xml;base64,");
}

.ico-settings {
  background-image: url("data:image/svg+xml;base64,");
}

/* 导出日历图标 — 日历 + 向右箭头（表示导出） */
.ico-calendar {
  background-image: url("data:image/svg+xml;base64,");
}

/* 导出中文字样式 */
.exporting-text {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  line-height: 1;
}

/* ----- 5. 课表外框与网格 ----- */
.timetable-wrapper {
  margin-top: 12rpx;
  border: 2rpx solid var(--color-border); /* 1px #CAC4D0 */
  border-radius: 20rpx; /* 10px */
  background: var(--color-surface);
  box-shadow: none;
}

.grid-date-cell {
  height: 40rpx;
  font-size: 18rpx; /* 9px */
  font-weight: 500;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}

.grid-header {
  background: var(--color-surface);
  border-bottom: 1rpx solid var(--color-divider);
}

.grid-header-cell {
  height: 44rpx;
  font-size: 18rpx; /* 9px */
  font-weight: 400;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
}

/* 时间轴：高度由 JS 通过 --hh 动态注入（hourHeight = 可用高度 / 24） */
.time-slot {
  height: var(--hh, 100rpx);
}

.time-slot-label {
  font-size: 16rpx; /* 8px */
  font-weight: 400;
  color: var(--color-text-secondary);
}

.day-col {
  min-height: calc(var(--hh, 100rpx) * 24);
  background-image: repeating-linear-gradient(
    to bottom,
    var(--color-divider) 0,
    var(--color-divider) 1rpx,
    transparent 1rpx,
    transparent var(--hh, 100rpx)
  );
}

/* ----- 6. 课程块：紧凑、四色实色板 ----- */
.course-block {
  left: 2rpx;
  right: 2rpx;
  border-radius: 12rpx; /* 6px */
  padding: 6rpx 8rpx;
}

.block-code {
  font-size: 20rpx; /* 10px，课程块文字整体大一码 */
  font-weight: 600;
  color: rgba(30, 30, 30, 0.72); /* 柔和深灰，避免扎眼 */
  line-height: 26rpx; /* 13px */
}

.block-name {
  font-size: 20rpx; /* 10px */
  font-weight: 600;
  color: rgba(30, 30, 30, 0.72);
  line-height: 26rpx;
  margin-top: 0;
}

.block-place {
  font-size: 17rpx; /* 8.5px */
  font-weight: 400;
  color: rgba(30, 30, 30, 0.55); /* 次级信息更淡 */
  line-height: 22rpx; /* 11px */
  margin-top: 2rpx;
}


/* 月视图事件颜色由 JS 内联输出；待补全样式优先于配色 */
.month-event.needs-review {
  color: #9d5a1b;
  background: rgba(255, 234, 201, 0.72);
}

/* 课程块内文字统一白色（实色底保证可读性） */
.course-block .block-code, .course-block .block-name {
  color: rgba(255, 255, 255, 0.96);
}
.course-block .block-place {
  color: rgba(255, 255, 255, 0.78);
}

/* ----- 周视图背景图（image 垫底 + 网格半透明显出底图） ----- */
.week-view-bg {
  position: relative;
}

.week-bg-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.week-view-bg .timetable-wrapper {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.55);
}

.week-view-bg .grid-date-row,
.week-view-bg .grid-header {
  background: rgba(255, 255, 255, 0.55);
}

/* ----- 日视图背景图（fixed 垫底铺满整屏，z-index:-1 位于页面背景之上、内容之下） ----- */
.day-bg-image {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

/* 淡色遮罩：把背景图底色 #F6F5E6 冲淡到接近 #FCFAF6 */
.day-bg-mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
  background: rgba(252, 250, 246, 0.62);
}

/* 日视图下去掉根容器的不透明渐变背景，否则会盖住 z-index:-1 的背景图 */
.schedule-page.day-bg-mode {
  background: none;
}

/* ----- 月视图右上角装饰贴纸：噗噗今天要干啥（镜像） ----- */
.month-corner-deco {
  position: absolute;
  top: 0;
  right: 0;
  height: 78rpx;
  z-index: 2;
  border-bottom-left-radius: 18rpx;
  pointer-events: none;
}

/* ----- 学期栏微调：月份紧贴周数、垂直居中（覆盖上方 flex:1 拉伸） ----- */
.semester-month {
  flex: none;
  align-self: center;
  margin-left: 2rpx;
  padding-left: 12rpx;
  line-height: 1;
}

/* ----- 黑夜模式：压暗背景图融入深色底 ----- */
.dark-mode .day-bg-image,
.dark-mode .day-bg-mask,
.dark-mode .week-bg-image {
  opacity: 1;
  filter: brightness(0.15) saturate(0.6);
}

.schedule-page.day-bg-mode.dark-mode {
  background: none;
}

.dark-mode .week-view-bg .timetable-wrapper,
.dark-mode .week-view-bg .grid-date-row,
.dark-mode .week-view-bg .grid-header {
  background: var(--color-surface);
}

/* ----- 黑夜模式：分段控件与时间列去白底 ----- */
.dark-mode .range-switch {
  background: rgba(26, 26, 46, 0.9);
}

.dark-mode .range-btn {
  color: var(--text-secondary);
}

.dark-mode .range-btn.active {
  background: var(--brand-primary);
  color: #ffffff;
}

.dark-mode .time-col {
  background: var(--color-surface);
}


.dark-mode .month-day {
  background: rgba(26, 26, 46, 0.6);
}

.dark-mode .month-day.muted {
  background: rgba(26, 26, 46, 0.3);
}


