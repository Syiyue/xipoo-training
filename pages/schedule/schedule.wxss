}

/* 教学周选择：横向排列的小方格，适合点选不连续周次（如 1、3、5）。 */
.week-picker-row { width: 100%; }
.week-chip-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 4rpx 0 8rpx;
}
.week-chip {
  width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  color: #71758f;
  background: #f0f1fa;
  border: 1rpx solid #dfe1f0;
