  text-overflow: ellipsis;
}
.flash-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
  height: 28rpx;
  overflow: hidden;
}
.flash-tags text {
  font-size: 18rpx;
  color: var(--brand-deep);
  white-space: nowrap;
}
.flash-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
  height: 64rpx;
}
.flash-reg-btn {
  flex: 55;
  min-width: 160rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--brand-primary);
  color: #fff;
  font-size: 23rpx;
  font-weight: 700;
}
.flash-reg-btn.active {
  background: var(--brand-tint);
  color: var(--brand-deep);
}
.flash-share-btn {
  flex: 45;
  min-width: 140rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f1f5f2;
  color: #68776e;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

/* ========== 快闪轮播分页圆点 ========== */
.flash-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}
.flash-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  transition: background 0.25s ease, transform 0.25s ease;
}
.flash-dot.active {
  background: var(--brand-bright);
  transform: scale(1.35);
}

/* ========== 选择活动弹出层 ========== */
.disco-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0,0,0,0.35);
}
.disco-picker-sheet {
  width: 100%;
  /* 必须用固定高度而非 max-height：部分微信 WebView 内核下 max-height 不能约束 flex 子项，
     会导致内部 scroll-view 被内容撑开而永远无法滚动 */
  height: 78vh;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  background: #fbfdfb;
  display: flex;
  flex-direction: column;
}
.dp-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 18rpx;
  flex-shrink: 0;
}
.dp-tabs {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.dp-tab {
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
  background: var(--brand-tint-2);
  color: #6b7d70;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}
.dp-tab::after {
  border: none;
}
.dp-tab.active {
  background: var(--brand-primary);
  color: #fff;
}
.dp-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}
.dp-footer-hint {
  flex: 1;
  color: #a9b8ae;
  font-size: 22rpx;
  line-height: 1.4;
}
.dp-footer .dp-done {
  flex-shrink: 0;
  margin: 0 0 0 auto;
}
.dp-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-ink);
}
.dp-hint {
  display: block;
  margin-top: 6rpx;
  color: #7e9787;
  font-size: 19rpx;
  line-height: 1.4;
}
.dp-done {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 28rpx;
  width: 112rpx;
  background: var(--brand-primary);
  color: #fff;
  font-size: 23rpx;
  font-weight: 600;
}
.dp-header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
.dp-restore-btn {
  width: 112rpx;
  height: 56rpx;
  padding: 0;
  border-radius: 28rpx;
  border: 1rpx solid var(--brand-border);
  background: #fff;
  color: var(--brand-deep);
  font-size: 24rpx;
  font-weight: 600;
}
.dp-restore-btn:active {
  background: var(--brand-tint-2);
}
.dp-search {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 0 24rpx 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  background: #f8faf9;
}
.dp-search-icon {
  font-size: 28rpx;
  color: #8a9b90;
}
.dp-search input {
  flex: 1;
  height: 64rpx;
  font-size: 24rpx;
  color: var(--brand-ink);
}
.dp-tags {
  margin: 0 24rpx 16rpx;
  white-space: nowrap;
  flex-shrink: 0;
}
.dp-tag {
  display: inline-flex;
  height: 56rpx;
  margin-right: 10rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: var(--brand-tint-2);
  color: #66766d;
  font-size: 22rpx;
  font-weight: 600;
}
.dp-tag.active {
  background: var(--brand-soft);
  color: var(--brand-ink);
}
.dp-organizers {
  flex: 1;
  /* flex 子项默认 min-height:auto，内容多时会撑破 max-height 导致 scroll-view 永不滚动 */
  min-height: 0;
  margin: 0 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.dp-org-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3f1;
}
.dp-org-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand-ink);
  font-size: 26rpx;
  font-weight: 800;
  flex-shrink: 0;
}
.dp-org-info {
  flex: 1;
  min-width: 0;
}
.dp-org-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.dp-org-name-row text:first-child {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-ink);
}
.dp-verified {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: var(--brand-tint);
  color: var(--brand-deep);
  font-size: 16rpx;
  font-weight: 700;
}
/* 未认证活动方的来源标注：摘自 xx */
.dp-source {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 234, 201, 0.72);
  color: #9a6a1b;
  font-size: 16rpx;
  font-weight: 700;
}
.dp-org-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #758279;
}
.dp-sub-btn {
  width: 108rpx;
  height: 54rpx;
  border-radius: 27rpx;
  background: var(--brand-tint);
  color: var(--brand-deep);
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.dp-sub-btn.active {
  background: var(--brand-primary);
  color: #fff;
}
/* 活动方操作按钮组 */
.dp-org-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}
.dp-select-btn {
  min-width: 100rpx;
  height: 54rpx;
  padding: 0 16rpx;
  border-radius: 27rpx;
  color: var(--brand-deep);
  background: var(--brand-tint);
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.dp-select-btn.active {
  color: #fff;
  background: var(--brand-primary);
}

/* ========== 订阅面板 ========== */
.subscription-panel {
  margin: 18rpx 24rpx 0;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 18rpx var(--brand-tint-2);
}
.panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.panel-head view { min-width: 0; flex: 1; }
.panel-head text { display: block; }
.panel-head text:first-child { color: var(--brand-ink); font-size: 27rpx; font-weight: 900; }
.panel-head text:last-child { margin-top: 6rpx; color: #748179; font-size: 19rpx; line-height: 1.45; }
.panel-head button { height: 48rpx; padding: 0 14rpx; border-radius: 8rpx; color: var(--brand-deep); background: var(--brand-tint); font-size: 18rpx; font-weight: 800; }
.publisher-list { margin-top: 14rpx; }
.publisher-row { display: flex; align-items: center; gap: 13rpx; padding: 16rpx 0; border-top: 1rpx solid #edf1ee; }
.publisher-avatar { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; border-radius: 50%; color: var(--brand-ink); font-size: 23rpx; font-weight: 900; }
.publisher-copy { min-width: 0; flex: 1; }
.publisher-copy text { display: block; }
.publisher-copy > view { display: flex; align-items: center; gap: 7rpx; }
.publisher-copy > view text:first-child { color: var(--brand-ink); font-size: 22rpx; font-weight: 900; }
.publisher-copy > view text:last-child { padding: 3rpx 7rpx; border-radius: 6rpx; color: var(--brand-deep); background: var(--brand-tint); font-size: 15rpx; font-weight: 800; }
.publisher-copy > text { margin-top: 4rpx; color: #758279; font-size: 17rpx; line-height: 1.35; }
.subscribe-button { width: 108rpx; height: 50rpx; border-radius: 9rpx; color: var(--brand-deep); background: var(--brand-tint); font-size: 18rpx; font-weight: 800; }
.subscribe-button.active { color: #fff; background: var(--brand-primary); }

/* ========== 发现页 - 活动方 ========== */
.discovery-organizers { margin: 18rpx 24rpx 0; }
.organizer-card { display: flex; align-items: center; gap: 13rpx; margin-bottom: 12rpx; padding: 16rpx; border: 1rpx solid var(--brand-border); border-radius: 8rpx; background: #fff; }
.organizer-copy { min-width: 0; flex: 1; }
.organizer-name-row { display: flex; align-items: center; gap: 8rpx; }
.organizer-name-row text:first-child { color: var(--brand-ink); font-size: 24rpx; font-weight: 900; }
.verified-badge { padding: 3rpx 8rpx; border-radius: 6rpx; color: var(--brand-deep); background: var(--brand-tint); font-size: 15rpx; font-weight: 800; }
.organizer-desc { display: block; margin-top: 6rpx; color: #758279; font-size: 19rpx; line-height: 1.4; }
.time-block { width: 82rpx; }
.time-block text { display: block; color: var(--brand-ink); font-size: 18rpx; font-weight: 800; }
.time-block text:last-child { margin-top: 5rpx; color: #8a968e; }
.day-line { width: 6rpx; height: 58rpx; margin: 0 14rpx 0 4rpx; border-radius: 3rpx; }
.day-copy { min-width: 0; flex: 1; }
.day-copy text { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.day-copy text:first-child { color: var(--brand-ink); font-size: 22rpx; font-weight: 900; }
.day-copy text:last-child { margin-top: 6rpx; color: #758279; font-size: 17rpx; }
.arrow { color: #849188; font-size: 30rpx; }
.feed-heading { margin-top: 25rpx; }
.feed-heading text { display: block; }
.feed-heading text:first-child { color: var(--brand-ink); font-size: 32rpx; font-weight: 900; }
.feed-heading text:last-child { margin-top: 5rpx; color: #77847c; font-size: 22rpx; line-height: 1.4; }
.activity-list { margin-top: 16rpx; }
.activity-row-card {
  display: flex;
  gap: 16rpx;
  margin-bottom: 14rpx;
  padding: 16rpx;
  border: 1rpx solid var(--brand-border);
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 10rpx 24rpx var(--brand-tint-2);
}
.activity-row-card > image {
  width: 154rpx;
  height: 154rpx;
  flex: 0 0 154rpx;
  border-radius: 8rpx;
  background: #e9efeb;
}
.activity-row-main { min-width: 0; flex: 1; }
.waterfall { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 16rpx; align-items: start; }
.waterfall-column { min-width: 0; }
.activity-card { margin-bottom: 12rpx; overflow: hidden; border: 1rpx solid var(--brand-border); border-radius: 8rpx; background: #fff; }
.activity-card > image { display: block; width: 100%; height: 230rpx; background: #e9efeb; }
.waterfall-column:nth-child(2) .activity-card:nth-child(2n) > image { height: 285rpx; }
.card-body { padding: 14rpx; }
.publisher-mini { display: flex; align-items: center; gap: 7rpx; min-width: 0; }
.publisher-mini text:first-child { display: flex; align-items: center; justify-content: center; width: 31rpx; height: 31rpx; border-radius: 50%; color: var(--brand-ink); font-size: 14rpx; font-weight: 900; }
.publisher-mini text:last-child { min-width: 0; flex: 1; overflow: hidden; color: #68776e; font-size: 16rpx; text-overflow: ellipsis; white-space: nowrap; }
.publisher-mini text:nth-child(3) { flex: 0 0 auto; padding: 3rpx 8rpx; border-radius: 6rpx; color: var(--brand-deep); background: var(--brand-tint); font-size: 15rpx; font-weight: 800; }
.activity-title { display: block; margin-top: 10rpx; color: var(--brand-ink); font-size: 26rpx; font-weight: 900; line-height: 1.38; }
.activity-meta { display: -webkit-box; margin-top: 7rpx; overflow: hidden; color: #79857e; font-size: 20rpx; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.tag-row { display: flex; flex-wrap: wrap; gap: 4rpx; margin-top: 9rpx; }
.tag-row text { color: var(--brand-deep); font-size: 15rpx; }
.card-actions { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.card-actions .register-button { flex: 55; min-width: 0; min-height: 64rpx; padding: 0 12rpx; border-radius: 16rpx; color: #fff; background: var(--brand-primary); font-size: 22rpx; font-weight: 700; }
.card-actions .register-button.active { color: var(--brand-deep); background: var(--brand-tint); }
.action-icons { display: flex; gap: 6rpx; flex-shrink: 0; }
.icon-btn { display: flex; align-items: center; justify-content: center; min-width: 0; min-height: 64rpx; flex: 45; padding: 0; border-radius: 16rpx; color: #68776e; background: #f1f5f2; font-size: 28rpx; line-height: 1; }
.icon-btn .icon-symbol { display: block; font-size: 28rpx; line-height: 1; }
.icon-btn .icon-label { display: none; }
.icon-btn-active { color: var(--brand-deep); background: var(--brand-tint); }
.empty-state { margin-top: 12rpx; padding: 34rpx 20rpx; border: 1rpx dashed var(--brand-border); border-radius: 8rpx; color: #7c8981; background: rgba(255,255,255,.58); font-size: 20rpx; text-align: center; }
.empty-state.large { margin-top: 22rpx; padding: 60rpx 20rpx; }
.modal-mask { position: fixed; z-index: 60; inset: 0; display: flex; align-items: flex-end; background: rgba(17,34,25,.46); }
.activity-editor { width: 100%; max-height: 90vh; padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 18rpx 18rpx 0 0; background: #fff; }
.editor-head { display: flex; align-items: center; justify-content: space-between; }
.editor-head text { color: var(--brand-ink); font-size: 28rpx; font-weight: 900; }
.editor-head button { height: 48rpx; padding: 0 13rpx; border-radius: 8rpx; color: var(--brand-deep); background: var(--brand-tint); font-size: 18rpx; }
.form-row { margin-top: 14rpx; }
.form-row > text { display: block; margin-bottom: 6rpx; color: #53665b; font-size: 19rpx; font-weight: 800; }
.form-row input, .form-row textarea { width: 100%; min-height: 64rpx; padding: 14rpx; border-radius: 8rpx; background: var(--brand-tint-2); font-size: 21rpx; }
.form-row textarea { height: 120rpx; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; }
.activity-editor .primary-btn { margin-top: 18rpx; }

/* 活动方选择器：移动端安全宽度与低饱和交互层级 */
.dp-organizers {
  width: auto;
  min-width: 0;
  margin: 0 20rpx;
}
.dp-org-row {
  width: 100%;
  min-width: 0;
  overflow: hidden;
  gap: 10rpx;
  padding: 18rpx 4rpx;
}
.dp-org-avatar {
  width: 64rpx;
  height: 64rpx;
  font-size: 23rpx;
  box-shadow: inset 0 0 0 1rpx var(--brand-border);
}
.dp-org-info {
  width: 0;
  min-width: 0;
  padding: 2rpx 0;
}
.dp-org-name-row {
  min-width: 0;
}
.dp-org-name-row text:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dp-org-desc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #77847c;
}
.dp-profile-link {
  display: block;
  margin-top: 5rpx;
  color: var(--brand-deep);
  font-size: 18rpx;
  font-weight: 700;
}
.dp-org-actions {
  width: 150rpx;
  flex: 0 0 150rpx;
  gap: 8rpx;
}
.dp-select-btn {
  width: 102rpx;
  min-width: 0;
  height: 50rpx;
  flex: 0 0 102rpx;
  padding: 0;
  border: 1rpx solid var(--brand-border);
  border-radius: 25rpx;
  color: var(--brand-deep);
  background: var(--brand-tint-2);
  font-size: 19rpx;
}
.dp-select-btn.active {
  border-color: var(--brand-border);
  color: var(--brand-deep);
  background: var(--brand-tint);
}
/* 活动方选择器头部与单一操作区 */
.dp-header { width: 100%; box-sizing: border-box; }
.dp-title { min-width: 0; flex: 1; white-space: nowrap; }
.dp-header-right { width: 236rpx; flex: 0 0 236rpx; gap: 12rpx; }
.dp-header-right .dp-restore-btn,
.dp-header-right .dp-done { width: 112rpx; min-width: 112rpx; max-width: 112rpx; flex: 0 0 112rpx; padding: 0; }
.dp-org-actions { width: 102rpx; flex: 0 0 102rpx; gap: 0; }
/* 已订阅来源与订阅管理入口 */
.dp-title-group { display: flex; align-items: center; min-width: 0; flex: 1; gap: 10rpx; }
.dp-title-group .dp-title { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dp-subscribe-token { width: 96rpx; min-width: 96rpx; max-width: 96rpx; height: 44rpx; flex: 0 0 96rpx; padding: 0; border: 1rpx solid var(--brand-border); border-radius: 22rpx; color: var(--brand-deep); background: var(--brand-tint); font-size: 18rpx; font-weight: 800; }
.dp-header-right { justify-content: flex-end; }
.dp-org-actions .dp-sub-btn { width: 102rpx; min-width: 102rpx; max-width: 102rpx; height: 50rpx; flex: 0 0 102rpx; padding: 0; font-size: 18rpx; }
.figma-page-header { margin-bottom: 16rpx; }
.view-switch { background: #ffffff; border-radius: 0; box-shadow: none; }
.view-switch button { border-radius: 30rpx; }
.view-switch button.active { color: #ffffff; background: var(--brand-primary); box-shadow: none; }
.event-card,
.discovery-card,
.activity-card {
  border: 3rpx solid var(--brand-primary);
  border-radius: 30rpx;
  background: #f4f4f4;
  box-shadow: none;
}
.week-day.selected { color: #212121; background: var(--brand-soft); }
.fab-btn { background: var(--brand-primary); box-shadow: none; }

/* 分段控件选中态：最终覆盖见下方（主色实底白字胶囊）。 */
.view-switch button.active {
  color: #212121;
  background: var(--brand-soft);
}

.event-card,
.discovery-card,
.activity-card {
  border-width: 2rpx;
  background: #ffffff;
}

/* ========== Figma：发现页最终视觉覆盖 ========== */
.activities-page {
  background: #f4f4f4;
}

.view-switch {
  height: 72rpx;
  margin: 0 24rpx;
  padding: 0;
  align-items: center;
  background: #ffffff;
}

.view-switch button {
  min-height: 64rpx;
  border-radius: 24rpx;
  color: #212121;
  font-size: 26rpx;
  font-weight: 600;
}

.view-switch button.active {
  color: var(--on-brand);
  background: var(--brand-primary);
  font-weight: 700;
}

.flash-section {
  margin-top: 28rpx;
}

.flash-head {
  margin: 0 28rpx 14rpx;
}

.flash-title {
  color: #212121;
  font-size: 30rpx;
  font-weight: 700;
}

.flash-hint {
  color: #555555;
  font-size: 20rpx;
}

.flash-swiper {
  width: 100%;
  height: 536rpx;
  padding: 0;
}

.flash-swiper swiper-item {
  box-sizing: border-box;
  padding: 0 24rpx;
}

.flash-card {
  box-sizing: border-box;
  position: relative;
  height: 520rpx;
  overflow: hidden;
  border: 0;
  border-radius: 26rpx;
  background: var(--brand-deep);
  box-shadow: none;
}

.flash-card-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: var(--brand-soft);
}

.flash-card-body {
  box-sizing: border-box;
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 0;
  padding: 90rpx 22rpx 20rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.88) 100%);
}

.flash-publisher {
  height: 34rpx;
  gap: 10rpx;
}

.flash-pub-avatar {
  width: 34rpx;
  height: 34rpx;
  font-size: 15rpx;
}

.flash-pub-name {
  color: rgba(255, 255, 255, 0.85);
  font-size: 20rpx;
}

.flash-card-title {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.25;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.6);
  -webkit-line-clamp: 1;
}

.flash-card-meta {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 21rpx;
}

.flash-tags {
  height: 25rpx;
  margin-top: 5rpx;
  gap: 6rpx;
}

.flash-tags text {
  color: #cdd1ff;
  font-size: 20rpx;
}

.flash-actions {
  height: 58rpx;
  margin-top: 10rpx;
  gap: 18rpx;
}

.flash-reg-btn,
.flash-share-btn {
  height: 58rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.flash-reg-btn {
  color: #ffffff;
  background: var(--brand-primary);
}

.flash-share-btn {
  color: var(--brand-deep);
  background: var(--brand-tint);
}

.flash-dots {
  gap: 12rpx;
  margin-top: 8rpx;
}

.flash-dot {
  width: 10rpx;
  height: 10rpx;
  background: var(--brand-soft);
}

.flash-dot.active {
  background: var(--brand-primary);
  transform: scale(1.5);
}

.feed-heading {
  margin: 26rpx 28rpx 0;
}

.feed-heading text:first-child {
  color: #212121;
  font-size: 30rpx;
  font-weight: 700;
}

.feed-heading text:last-child {
  margin-top: 2rpx;
  color: #555555;
  font-size: 21rpx;
}

.waterfall {
  gap: 16rpx;
  margin: 14rpx 24rpx 0;
}

.activity-card,
.event-card,
.discovery-card {
  border: 2rpx solid var(--card-border);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: none;
}

.activity-card {
  position: relative;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.activity-card > image,
.waterfall-column:nth-child(2) .activity-card:nth-child(2n) > image {
  height: 456rpx;
  background: var(--brand-soft);
}

.card-body {
  padding: 14rpx 14rpx 16rpx;
}

.publisher-mini {
  gap: 7rpx;
}

.publisher-mini text:first-child {
  width: 30rpx;
  height: 30rpx;
  font-size: 13rpx;
}

.publisher-mini text:last-child {
  color: #555555;
  font-size: 20rpx;
}

.activity-title {
  margin-top: 9rpx;
  color: #212121;
  font-size: 24rpx;
  line-height: 1.28;
  /* 统一卡片高度：标题固定单行，避免瀑布流高低错落 */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.activity-meta {
  margin-top: 5rpx;
  color: #555555;
  font-size: 20rpx;
  line-height: 1.3;
  -webkit-line-clamp: 1;
}

.tag-row {
  height: 23rpx;
  margin-top: 5rpx;
  overflow: hidden;
}

.tag-row text {
  color: var(--brand-deep);
  font-size: 18rpx;
  white-space: nowrap;
}

.card-actions {
  height: 56rpx;
  margin-top: 10rpx;
  gap: 10rpx;
}

.card-actions .register-button {
  min-height: 56rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: var(--brand-primary);
  font-size: 21rpx;
}

.card-actions .register-button.active {
  color: var(--brand-deep);
  background: var(--brand-tint);
}

.card-actions .icon-btn {
  width: 56rpx;
  min-width: 56rpx;
  min-height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 18rpx;
  color: var(--brand-deep);
  background: var(--brand-tint);
}

/* ----- 页面背景图（fixed 垫底，盖住页面底色） ----- */
.activities-page {
  background: none;
}

.page-bg-image {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: -1;
}

/* ----- 分段控件：容器与选中态统一为胶囊，去掉矩形+圆角的别扭感 ----- */
.view-switch {
  border-radius: 40rpx;
  padding: 6rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 2rpx 12rpx rgba(124, 131, 199, 0.12);
}

.view-switch button {
  border-radius: 32rpx;
}

.view-switch button.active {
  color: #ffffff;
  background: var(--brand-primary);
}

/* ----- 月历：经典日历样式（星期头加底色、日期数字居左上、周末着色） ----- */
.mv-weekdays {
  padding: 12rpx 0;
  background: var(--brand-tint);
  border-bottom: 1rpx solid var(--brand-border);
}

.mv-weekdays text {
  font-weight: 700;
  color: var(--brand-deep);
}

.mv-weekdays text:first-child,
.mv-weekdays text:last-child {
  color: var(--brand-primary);
}

.mv-cell {
  align-items: flex-start;
  padding: 10rpx 8rpx;
}

.mv-day-num {
  align-self: flex-start;
}

.mv-cell.today .mv-day-num {
  align-self: flex-start;
}

.mv-dots {
  align-self: center;
  margin-top: auto;
}

/* ----- 黑夜模式：压暗背景图融入深色底 ----- */
.dark-mode .page-bg-image {
  opacity: 1;
  filter: brightness(0.15) saturate(0.6);
}

.activities-page.dark-mode {
  background: none;
}

/* ----- 活动方选择弹层背景图（垫底，内容抬到上层） ----- */
.disco-picker-sheet {
  position: relative;
}

.dp-bg-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.disco-picker-sheet .dp-header,
.disco-picker-sheet .dp-search,
.disco-picker-sheet .dp-tags,
.disco-picker-sheet .dp-organizers,
.disco-picker-sheet .dp-footer {
  position: relative;
  z-index: 1;
}

.dark-mode .dp-bg-image {
  display: none;
}

/* ----- 黑夜模式整改 ----- */
.dark-mode .activity-card,
.dark-mode .event-card,
.dark-mode .discovery-card,
.dark-mode .calendar-day-panel,
.dark-mode .calendar-source-entry,
.dark-mode .month-view {
  background: var(--card-bg);
  border-color: var(--card-border);
}

.dark-mode .flash-title,
.dark-mode .flash-card-title,
.dark-mode .activity-title,
.dark-mode .cal-year-month,
.dark-mode .mv-day-num {
  color: var(--text-primary);
}

.dark-mode .mv-cell.muted .mv-day-num,
.dark-mode .flash-hint {
  color: var(--text-muted);
}

.dark-mode .view-switch {
  background: rgba(26, 26, 46, 0.92);
  box-shadow: none;
}

.dark-mode .view-switch button {
  color: var(--text-secondary);
}

.dark-mode .view-switch button.active {
  color: #ffffff;
  background: var(--brand-primary);
}

.dark-mode .disco-hero {
  box-shadow: none;
}

.dark-mode .feat-card {
  background: var(--card-bg);
  border-color: var(--card-border);
  box-shadow: none;
}

.dark-mode .feat-name {
  color: #f4f4f4;
}

.dark-mode .disco-picker-sheet {
  background: var(--card-bg);
}

/* ----- 黑夜模式：热门卡片去白底 ----- */
.dark-mode .flash-card {
  background: var(--card-bg);
  box-shadow: none;
}

.dark-mode .flash-card-meta {
  color: var(--text-secondary);
}

.dark-mode .dp-bg-image {
  opacity: 1;
  filter: brightness(0.15) saturate(0.6);
}

/* ===== 加载骨架屏 ===== */
.skeleton-wrap {
  padding: 4rpx 0;
}

.skeleton-card {
  height: 240rpx;
  margin-bottom: 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, #ececf1 25%, #f8f8fb 50%, #ececf1 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.4s linear infinite;
}

.dark-mode .skeleton-card {
  background: linear-gradient(90deg, #2a2d3a 25%, #34384a 50%, #2a2d3a 75%);
  background-size: 200% 100%;
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

