}
.feat-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  margin-bottom: 12rpx;
  background: var(--brand-tint);
  flex-shrink: 0;
  overflow: hidden;
}
.feat-logo-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242a62;
  font-size: 30rpx;
  font-weight: 800;
}
.feat-name-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: 100%;
}
.feat-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #212121;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.feat-verified {
  color: var(--brand-primary);
  font-size: 20rpx;
  flex-shrink: 0;
}
.feat-tagline {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #555555;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: normal;
  line-height: 1.4;
  min-height: 50rpx;
  max-width: 100%;
}
.feat-count {
  margin-top: auto;
  padding-top: 8rpx;
  font-size: 18rpx;
  color: var(--brand-deep);
  font-weight: 600;
}

/* 热门轮播卡增强：左上角热门角标 + 主色描边光晕 */
.flash-card {
  position: relative;
  border: 2rpx solid var(--brand-soft);
  box-shadow: 0 10rpx 30rpx var(--brand-tint);
}
.flash-corner {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  z-index: 2;
  padding: 6rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #f2924a, #ef4444);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.35);
}

/* ========== 发现页 - 快闪轮播 ========== */
.flash-section {
  margin: 24rpx 0 0;
}
.flash-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 16rpx;
}
.flash-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-ink);
}
.flash-hint {
  font-size: 20rpx;
  color: #a3b8aa;
}
.flash-swiper {
  height: 620rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.flash-card {
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 6rpx 24rpx var(--brand-tint);
}
.flash-card-img {
  display: block;
  width: 100%;
  height: 360rpx;
  background: #e9efeb;
  flex-shrink: 0;
}
.flash-card-body {
  padding: 20rpx 24rpx 24rpx;
  min-height: 260rpx;
  box-sizing: border-box;
}
.flash-publisher {
