/* 活动卡片统一规范（状态标签/文字基线/右侧数据），见 styles/activity-card.wxss */
@import '../../styles/activity-card.wxss';

/* ========== 全局页面 ========== */
.activities-page {
  min-height: 100vh;
  min-height: 100dvh;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  background: var(--page-bg-gradient);
}

/* ========== 顶部双标签切换栏 ========== */
/* ========== 游客提示条 ========== */
.guest-tip-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(12rpx);
  box-shadow: 0 4rpx 20rpx var(--brand-tint-2);
}
.guest-tip-text {
  color: #7a9c87;
  font-size: 26rpx;
}
.guest-tip-action {
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 700;
}

.view-switch {
  display: flex;
  margin: 0 24rpx;
  margin-top: 20rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(12rpx);
  box-shadow: 0 4rpx 20rpx var(--brand-tint-2);
}
.view-switch button {
  flex: 1;
  min-height: 76rpx;
  padding: 0 4rpx;
  border-radius: 12rpx;
  color: #7a9c87;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  background: transparent;
  transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}
.view-switch button.active {
  color: var(--brand-ink);
  background: var(--brand-soft);
  font-weight: 700;
  box-shadow: 0 3rpx 14rpx var(--brand-soft);
}

/* ========== 日历视图头部：年月标题 + 视图切换图标按钮 ========== */
.cal-header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 0;
  position: relative;
}
.cal-year-month {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand-ink);
  letter-spacing: 1rpx;
  font-family: -apple-system, "Helvetica Neue", sans-serif;
}
.cal-header-actions {
  display: flex;
  align-items: center;
  gap: 0;
  position: relative;
  z-index: 20;
}
.cal-view-icon-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.view-icon-book {
  font-size: 40rpx;
  color: var(--brand-deep);
  line-height: 1;
}

/* ========== 视图切换下拉浮窗 ========== */
.view-dropdown {
  position: absolute;
  right: 0;
  top: 68rpx;
  z-index: 50;
  width: 220rpx;
  padding: 8rpx 0;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 8rpx 36rpx rgba(23,54,36,0.14);
  overflow: hidden;
}
.view-option {
  display: flex;
  align-items: center;
  height: 80rpx;
  padding: 0 20rpx;
}
.vo-icon {
  width: 40rpx;
  font-size: 28rpx;
  text-align: center;
  flex-shrink: 0;
}
.vo-label {
  flex: 1;
  font-size: 26rpx;
  color: var(--brand-ink);
  margin-left: 8rpx;
}
.view-option.active .vo-label {
  color: #4080ff;
  font-weight: 600;
}
.vo-check {
  width: 32rpx;
  font-size: 24rpx;
  color: #4080ff;
  text-align: right;
}
.dropdown-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
}

/* ========== 小型横向周历条 ========== */
.cal-week-strip {
  display: flex;
  justify-content: space-between;
  height: 100%;
  margin: 18rpx 24rpx 0;
  padding: 16rpx 12rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.68);
  backdrop-filter: blur(8rpx);
  box-shadow: 0 2rpx 14rpx var(--brand-tint-2);
}
.week-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 0;
  padding: 8rpx 4rpx;
  border-radius: 14rpx;
  transition: all 0.2s ease;
}
.week-day-label {
  font-size: 19rpx;
  color: #89a091;
  font-weight: 500;
}
.week-day-num {
  font-size: 26rpx;
  color: var(--brand-ink);
  font-weight: 600;
}
.week-day.today .week-day-num {
  color: #fff;
  background: var(--brand-bright);
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.week-day.selected {
  background: var(--brand-tint);
}
.week-day-dot {
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: var(--brand-bright);
  margin-top: 2rpx;
}

/* ========== 主体时间线 ========== */
.cal-timeline {
  margin: 16rpx 24rpx 0;
  height: calc(100vh - 460rpx - env(safe-area-inset-bottom));
}

/* ========== 月份分组 ========== */
.month-group {
  margin-bottom: 4rpx;
}
.month-divider {
  padding: 20rpx 8rpx 10rpx;
}
.month-divider text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-ink);
  letter-spacing: 0.5rpx;
}

/* 列表分页加载提示 */
.list-loading-more {
  padding: 24rpx 0;
  text-align: center;
}
.list-loading-more text {
  font-size: 24rpx;
  color: #8aa393;
}

/* ========== 每日行 ========== */
.day-row {
  display: flex;
  margin-bottom: 12rpx;
  gap: 14rpx;
}
.day-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 64rpx;
  padding-top: 10rpx;
  flex-shrink: 0;
}
.day-date {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-ink);
  line-height: 1;
}
.day-weekday {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #89a091;
  font-weight: 500;
}
.day-right {
  flex: 1;
  min-width: 0;
}

/* ========== 日程卡片 ========== */
.event-card {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  margin-bottom: 10rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 3rpx 18rpx var(--brand-tint-2);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.event-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 10rpx var(--brand-tint-2);
}
.event-dot {
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.event-info {
  flex: 1;
  min-width: 0;
}
.event-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.event-time {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #8ba395;
  font-weight: 400;
}
.event-arrow {
  font-size: 30rpx;
  color: #b7c9bd;
  flex-shrink: 0;
  margin-left: 10rpx;
}

/* ========== 空日期 ========== */
.day-empty {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.45);
  border: 2rpx dashed transparent;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.day-empty:active {
  border-color: var(--brand-bright);
  background: var(--brand-tint-2);
}
.day-empty-title {
  display: block;
  font-size: 21rpx;
  color: #a3b8aa;
}
.day-empty-add {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--brand-bright);
  font-weight: 500;
}

/* ========== 单日视图 (24h单栏时间轴) ========== */
.single-day-view {
  margin: 16rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 3rpx 18rpx var(--brand-tint-2);
}
.sd-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 16rpx;
  border-bottom: 1rpx solid var(--brand-tint);
}
.sd-nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--brand-tint-2);
  font-size: 34rpx;
  color: var(--brand-deep);
}
.sd-nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-ink);
  padding: 8rpx 20rpx;
  border-radius: 10rpx;
  transition: background 0.2s ease;
}
.sd-nav-title:active {
  background: var(--brand-tint);
}
.sd-date-label { display: none; }
.sd-weekday-label { display: none; }
.sd-timeline {
  height: calc(100vh - 560rpx - env(safe-area-inset-bottom));
}
.sd-grid {
  padding: 8rpx 0;
}
.sd-slot-row {
  display: flex;
  min-height: 80rpx;
  border-bottom: 1rpx solid var(--brand-tint-2);
}
.sd-hour {
  width: 80rpx;
  padding: 10rpx 8rpx 0 16rpx;
  font-size: 20rpx;
  color: #8ba395;
  text-align: right;
  flex-shrink: 0;
}
.sd-slot-content {
  flex: 1;
  padding: 4rpx 12rpx 4rpx 4rpx;
  min-height: 80rpx;
  position: relative;
}
.sd-slot-content.has-event {
  background: var(--brand-tint-2);
}
.sd-slot-content.active-slot {
  opacity: 0.92;
}
/* 单日空白时段占位框 */
.sd-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin: 2rpx 0;
  border: 2rpx dashed var(--brand-bright);
  border-radius: 12rpx;
  background: var(--brand-tint-2);
}
.sd-placeholder-text {
  font-size: 24rpx;
  color: var(--brand-bright);
  font-weight: 500;
}
.sd-event-block {
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  border-left: 6rpx solid;
  margin: 2rpx 0;
}
.sd-event-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-ink);
}
.sd-event-time {
  display: block;
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #8ba395;
}

/* ========== 双日视图 (双栏时间轴) ========== */
.double-day-view {
  margin: 16rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 3rpx 18rpx var(--brand-tint-2);
}
.dd-header {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--brand-tint);
}
.dd-date-label {
  flex: 1;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-ink);
  text-align: center;
}
.dd-timeline {
  height: calc(100vh - 560rpx - env(safe-area-inset-bottom));
}
.dd-grid {
  display: flex;
}
.dd-hours-col {
  width: 72rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
}
.dd-hour-cell {
  height: 80rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 10rpx 8rpx 0 0;
}
.dd-hour {
  font-size: 20rpx;
  color: #8ba395;
}
.dd-day-col {
  flex: 1;
  border-left: 1rpx solid var(--brand-tint);
}
.dd-slot {
  height: 80rpx;
  border-bottom: 1rpx solid var(--brand-tint-2);
  padding: 2rpx 6rpx;
  position: relative;
}
.dd-slot.has-event {
  background: var(--brand-tint-2);
}
.dd-slot.active-slot {
  opacity: 0.92;
}
/* 双日空白时段占位框 */
.dd-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border: 2rpx dashed var(--brand-bright);
  border-radius: 10rpx;
  background: var(--brand-tint-2);
}
.dd-placeholder-text {
  font-size: 22rpx;
  color: var(--brand-bright);
  font-weight: 500;
}
.dd-event-block {
  padding: 8rpx 10rpx;
  border-radius: 8rpx;
  border-left: 5rpx solid;
  height: 100%;
}
.dd-event-title {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--brand-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 月视图 (7列日历网格) ========== */
.month-view {
  margin: 16rpx 8rpx 0; /* 左右间距收窄，日历整体更大 */
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 3rpx 18rpx var(--brand-tint-2);
}
.mv-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
}
.mv-nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: var(--brand-tint-2);
  font-size: 34rpx;
  color: var(--brand-deep);
}
.mv-nav-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--brand-ink);
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  transition: background 0.2s ease;
}
.mv-nav-title:active {
  background: var(--brand-tint);
}
.mv-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 8rpx 8rpx 4rpx;
  border-bottom: 1rpx solid var(--brand-tint);
}
.mv-weekdays text {
  font-size: 24rpx; /* 星期文字随日历一起放大 */
  color: #8ba395;
  text-align: center;
}
.mv-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  border-left: 1rpx solid var(--brand-tint-2);
  border-top: 1rpx solid var(--brand-tint-2);
}
.mv-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 2rpx 10rpx;
  min-height: 112rpx; /* 格子加大 */
  border-right: 1rpx solid var(--brand-tint-2);
  border-bottom: 1rpx solid var(--brand-tint-2);
}
.mv-cell.muted .mv-day-num {
  color: #c8d4cc;
}
.mv-cell.today {
  background: var(--brand-tint);
}
.mv-cell.selected {
  background: var(--brand-soft);
  box-shadow: inset 0 0 0 2rpx var(--brand-soft);
}
.mv-day-num {
  font-size: 28rpx; /* 日期数字加大 */
  font-weight: 600;
  color: var(--brand-ink);
}
.mv-cell.today .mv-day-num {
  color: #fff;
  background: var(--brand-bright);
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}
.mv-dots {
  display: flex;
  gap: 3rpx;
  margin-top: 4rpx;
  flex-wrap: wrap;
  justify-content: center;
}
.mv-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.calendar-day-panel,
.calendar-source-entry {
  margin: 16rpx 24rpx 0;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 3rpx 18rpx var(--brand-tint-2);
}
.calendar-day-panel {
  overflow: hidden;
}
.calendar-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid var(--brand-tint);
}
.calendar-section-head text:first-child {
  color: var(--brand-ink);
  font-size: 27rpx;
  font-weight: 800;
}
.calendar-section-head text:last-child {
  color: #7e9787;
  font-size: 21rpx;
}
.selected-activity-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--brand-tint-2);
}
.selected-activity-row:last-child {
  border-bottom: 0;
}
.selected-activity-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.selected-activity-main {
  min-width: 0;
  flex: 1;
}
.selected-activity-main text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.selected-activity-main text:first-child {
  color: var(--brand-ink);
  font-size: 25rpx;
  font-weight: 700;
}
.selected-activity-main text:last-child {
  margin-top: 5rpx;
  color: #8ba395;
  font-size: 20rpx;
}
.selected-activity-arrow {
  color: #b7c9bd;
  font-size: 30rpx;
}
.selected-day-empty {
  padding: 28rpx 24rpx;
  color: #91a99a;
  font-size: 23rpx;
  text-align: center;
}
.calendar-source-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
}
.calendar-source-entry view text {
  display: block;
}
.calendar-source-entry view text:first-child {
  color: var(--brand-ink);
  font-size: 26rpx;
  font-weight: 800;
}
.calendar-source-entry view text:last-child {
  margin-top: 6rpx;
  color: #7e9787;
  font-size: 21rpx;
}
.calendar-source-entry > text {
  color: #89a091;
  font-size: 34rpx;
}

/* ========== 月视图空白日期气泡弹窗 ========== */
.month-popup-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.35);
}
.month-popup-bubble {
  position: relative;
  width: 88%;
  max-width: 660rpx;
  padding: 48rpx 40rpx 32rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.12);
}
.mp-close {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #bbb;
}
.mp-body {
  text-align: center;
  margin-bottom: 28rpx;
}
.mp-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand-ink);
}
.mp-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8ba395;
}
.mp-create-btn {
  width: 100%;
  height: 76rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, var(--brand-bright) 0%, var(--brand-deep) 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
.mp-arrow {
  position: absolute;
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 20rpx solid #fff;
}

/* ========== 月份选择器底部弹窗 ========== */
.month-picker-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: flex-end;
  background: rgba(0,0,0,0.35);
}
.month-picker-sheet {
  width: 100%;
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.mpick-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #f0f3f1;
}
.mpick-cancel {
  font-size: 28rpx;
  color: #999;
}
.mpick-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--brand-ink);
}
.mpick-confirm {
  font-size: 28rpx;
  color: var(--brand-bright);
  font-weight: 600;
}
.mpick-body {
  padding: 16rpx 0;
}
.mpick-view {
  height: 440rpx;
}
.mpick-item {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #333;
}

/* ========== 发现页 - 查找活动方吸睛横幅 + 优秀活动方 ========== */
.disco-hero {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #8B7BE0 0%, #6659D0 55%, #4F46B8 100%);
  box-shadow: 0 12rpx 32rpx rgba(102, 89, 208, 0.38);
  display: flex;
  align-items: center;
  transition: transform 0.18s ease;
}
.disco-hero:active {
  transform: scale(0.98);
}

/* π空间专属入口（模块 4）：白底卡片与 disco-hero 渐变横幅协调搭配 */
.pai-entry {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 2rpx solid var(--brand-border, #d5d7eb);
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.14);
  display: flex;
  align-items: center;
  gap: 20rpx;
  transition: transform 0.18s ease;
}
.pai-entry:active, .pai-entry-hover {
  transform: scale(0.98);
}
.pai-entry-logo {
  width: 84rpx;
  height: 84rpx;
  border-radius: 18rpx;
  background: #f4f2ff;
  flex-shrink: 0;
}
.pai-entry-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.pai-entry-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #6d5bd0;
}
.pai-entry-sub {
  font-size: 20rpx;
  color: #79857e;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.pai-entry-arrow {
  font-size: 40rpx;
  color: #a78bfa;
  flex-shrink: 0;
}
.dark-mode .pai-entry {
