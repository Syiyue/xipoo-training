  gap: 10rpx;
  height: 36rpx;
}
.flash-pub-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  color: var(--brand-ink);
  font-size: 16rpx;
  font-weight: 800;
  flex-shrink: 0;
}
.flash-pub-avatar:active,
.publisher-mini text:first-child:active,
.dp-org-avatar:active,
.publisher-avatar:active { transform: scale(.92); }
.flash-pub-name {
  font-size: 22rpx;
  color: #68776e;
}
.flash-card-title {
  display: -webkit-box;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-ink);
  line-height: 1.38;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}
.flash-card-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #79857e;
