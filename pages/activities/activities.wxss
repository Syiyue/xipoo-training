}
.disco-hero-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.disco-hero-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 2rpx;
}
.disco-hero-title::before {
  content: '⌕ ';
  font-weight: 900;
}
.disco-hero-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.82);
}
.disco-hero-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.disco-hero-illustration {
  width: 136rpx;
  height: 112rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.68);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.18);
}
.disco-hero-avatars {
  display: flex;
}
.disco-hero-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242a62;
  font-size: 18rpx;
  font-weight: 800;
  border: 3rpx solid #ffffff;
  margin-left: -14rpx;
}
.disco-hero-avatar:first-child {
  margin-left: 0;
}
.disco-hero-arrow {
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 300;
  margin-left: 14rpx;
  line-height: 1;
}

.dark-mode .disco-hero-illustration {
  opacity: 0.8;
}

/* 优秀活动方横滑卡片 */
.feat-section {
  margin: 28rpx 0 0;
}
.feat-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 28rpx;
  margin-bottom: 14rpx;
}
.feat-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-ink);
}
.feat-more {
  font-size: 22rpx;
  color: var(--brand-deep);
}
.feat-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.feat-card {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  width: 220rpx;
  height: 252rpx;
