/* Xipoo 登录页 - 淡紫渐变封面风格 */
/* 背景为浅紫渐变 + 朦胧装饰圆，主视觉为透明底章鱼插画 */

page {
  background: linear-gradient(180deg, #D9CDF7 0%, #CDBEF4 45%, #C2B0F0 100%);
}
.login-page {
  min-height: 100vh;
  padding: 110rpx 48rpx 50rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* ---- 背景装饰圆 ---- */
.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  pointer-events: none;
}
.deco-circle-1 {
  width: 560rpx;
  height: 560rpx;
  top: -180rpx;
  left: -200rpx;
}
.deco-circle-2 {
  width: 420rpx;
  height: 420rpx;
  top: 560rpx;
  right: -180rpx;
  background: rgba(255, 255, 255, 0.08);
}
.deco-circle-3 {
  width: 640rpx;
  height: 640rpx;
  bottom: -240rpx;
  left: 80rpx;
  background: rgba(255, 255, 255, 0.07);
}

/* ---- 语言切换 - 左上角胶囊 ---- */
.lang-bar {
  position: absolute;
  top: 100rpx;
  left: 48rpx;
  z-index: 10;
  display: flex;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 30rpx;
  padding: 4rpx;
  box-shadow: 0 2rpx 12rpx rgba(124, 92, 214, 0.15);
}
.lang-segment {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #7C5CD6;
  border-radius: 26rpx;
  transition: background 200ms, color 200ms;
}
.lang-segment-en {
  min-width: 78rpx;
  text-align: center;
  letter-spacing: 0.2rpx;
}
.lang-segment.active {
  background: #7C5CD6;
  color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(124, 92, 214, 0.35);
}

/* ---- 顶部品牌区 ---- */
.brand-area {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  margin-top: 150rpx;
  position: relative;
  z-index: 1;
}
.slogan-sub {
  font-size: 28rpx;
  font-weight: 600;
  color: #6D4FC4;
  line-height: 1.4;
  letter-spacing: 4rpx;
}

/* ---- 中部主视觉 ---- */
.illustration-area {
  width: 100%;
  height: 380rpx;
  margin-top: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  z-index: 1;
}
.illustration-img {
  width: 560rpx;
  height: 368rpx;
  display: block;
}

/* ---- 文案区 ---- */
.hero-copy {
  width: 100%;
  margin-top: 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #5A3CB8;
  letter-spacing: 2rpx;
  text-align: center;
}
.hero-sub {
  margin-top: 22rpx;
  font-size: 26rpx;
  font-weight: 400;
  color: rgba(90, 60, 184, 0.75);
  line-height: 1.6;
  text-align: center;
  white-space: pre-line;
}
.tag-row {
  margin-top: 36rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}
.tag-pill {
  padding: 10rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6D4FC4;
  background: rgba(255, 255, 255, 0.45);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 30rpx;
}

/* ---- 协议勾选 ---- */
.agreement-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 60rpx;
  position: relative;
  z-index: 1;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 150ms, border-color 150ms;
}
.checkbox.checked {
  background: #ffffff;
  border-color: #ffffff;
}
.checkmark {
  color: #7C5CD6;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1;
}
.agree-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.5;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.link {
  color: #ffffff;
  font-weight: 600;
  text-decoration: underline;
  display: inline;
}

/* ---- 登录按钮 ---- */
.login-btn {
  width: 100%;
  max-width: 600rpx;
  height: 100rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, #8B6BE0 0%, #6D4FC4 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 40rpx;
  align-self: center;
  box-shadow: 0 10rpx 30rpx rgba(109, 79, 196, 0.4);
  transition: transform 120ms ease, opacity 120ms;
  border: none;
  outline: none;
  padding: 0;
  position: relative;
  z-index: 1;
}
.login-btn::after {
  border: none;
}
.login-btn:active {
  transform: scale(0.96);
}
.login-btn.disabled {
  background: rgba(255, 255, 255, 0.3);
  color: rgba(255, 255, 255, 0.9);
  box-shadow: none;
  opacity: 1;
}
.login-btn.disabled:active {
  transform: none;
}
.btn-icon {
  font-size: 28rpx;
  font-weight: 700;
}

/* ---- 先逛逛 ---- */
.browse-first {
  margin-top: 28rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  text-decoration: underline;
  padding: 16rpx 0;
  position: relative;
  z-index: 1;
}

/* ---- 版权 ---- */
.copyright {
  margin-top: auto;
  padding-top: 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  position: relative;
  z-index: 1;
}

/* ----- 黑夜模式：深紫底，文字转浅色 ----- */
.login-page.dark-mode {
  background: linear-gradient(180deg, #241D3D 0%, #1A1530 50%, #120E20 100%);
}

.login-page.dark-mode .slogan-sub {
  color: #B9A5F5;
}

.login-page.dark-mode .hero-title {
  color: #E6DEFA;
}

.login-page.dark-mode .hero-sub {
  color: rgba(255, 255, 255, 0.75);
}

.login-page.dark-mode .tag-pill {
  color: #D9CDF7;
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.2);
}
